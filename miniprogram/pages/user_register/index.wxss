/* user_register/index.wxss */
page {
  background: linear-gradient(180deg, #FFF5F7 0%, #F0F8FF 50%, #FFFBF0 100%);
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.content {
  width: 100%;
  max-width: 600rpx;
}

/* 头部区域 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

/* 表单区域 */
.form {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

/* 标签页 */
.tabs {
  display: flex;
  margin-bottom: 40rpx;
  background-color: #F8F8F8;
  border-radius: 20rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #999999;
  position: relative;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.tab.active {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 128, 0.35);
}

.tab.active::after {
  display: none;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.input-wrapper {
  background-color: #F8F8F8;
  border-radius: 24rpx;
  padding: 0 30rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: #FFB7B2;
  background-color: #FFFFFF;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

/* 验证码区域 */
.code-wrapper {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  width: 50%;
}

.code-btn {
  flex: 1;
  width: 50%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #63B3ED 100%);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: none;
  padding: 0;
  line-height: 96rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

.code-btn.disabled {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  box-shadow: none;
}

.code-btn::after {
  border: none;
}

.hint-text {
  display: block;
  font-size: 22rpx;
  color: #FF9800;
  margin-top: 10rpx;
  margin-left: 30rpx;
}

/* 密码区域 */
.password-wrapper {
  position: relative;
}

.eye-icon {
  width: 44rpx;
  height: 44rpx;
  margin-left: 20rpx;
  opacity: 0.5;
}

/* 密码强度指示器 */
.password-strength {
  margin-top: 15rpx;
  padding: 0 30rpx;
}

.strength-bar {
  height: 8rpx;
  background-color: #F5F5F5;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.strength-fill {
  height: 100%;
  transition: width 0.3s, background-color 0.3s;
  border-radius: 4rpx;
}

.strength-fill.strength-1 {
  background-color: #FF6B6B;
}

.strength-fill.strength-2 {
  background-color: #FFA500;
}

.strength-fill.strength-3 {
  background-color: #4CAF50;
}

.strength-text {
  font-size: 22rpx;
  color: #999999;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 128, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.register-btn[disabled] {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  box-shadow: none;
}

.register-btn::after {
  border: none;
}

/* 底部链接 */
.footer-links {
  text-align: center;
  margin-top: 40rpx;
}

.link {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 500;
}
