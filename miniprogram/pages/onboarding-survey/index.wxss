/* pages/onboarding-survey/index.wxss */
page {
  background: #E8D5F0;
  height: 100%;
}

.survey-container {
  min-height: 100vh;
  padding: 120rpx 0 220rpx 0;
  background: #E8D5F0;
}

/* 进度指示器 */
.progress-bar {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  margin: 40rpx 30rpx 50rpx 30rpx;
  padding: 45rpx 35rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
}

.step-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  color: #CCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.3s;
}

.step.active .step-circle {
  background: linear-gradient(135deg, #FFB7B2 0%, #FEE5E6 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 178, 0.3);
}

.step-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #CCC;
  transition: all 0.3s;
}

.step.active .step-label {
  color: #FFB7B2;
  font-weight: bold;
}

.step-line {
  flex: 1;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.5);
  margin: 0 15rpx;
  transition: all 0.3s;
}

.step-line.active {
  background: linear-gradient(90deg, #FFB7B2 0%, #FEE5E6 100%);
}

/* 步骤内容 */
.step-content {
  margin: 0 30rpx;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.step-header {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  padding: 50rpx 40rpx;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.step-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #444;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.step-subtitle {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

/* 选项网格（第一步、第二步） */
.options-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.option-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 35rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  min-height: 220rpx;
}

.option-emoji {
  font-size: 65rpx;
  margin-bottom: 18rpx;
  transition: all 0.2s;
}

.option-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #444;
  margin-bottom: 10rpx;
  transition: all 0.2s;
}

.option-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
  transition: all 0.2s;
}

.option-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 45rpx;
  height: 45rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB7B2 0%, #FEE5E6 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 183, 178, 0.3);
}

/* 选项列表（第三步） */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-card-large {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  position: relative;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.option-left {
  margin-right: 22rpx;
}

.option-emoji-large {
  font-size: 75rpx;
  transition: all 0.2s;
}

.option-right {
  flex: 1;
}

.option-name-large {
  font-size: 32rpx;
  font-weight: bold;
  color: #444;
  margin-bottom: 10rpx;
  transition: all 0.2s;
}

.option-desc-large {
  font-size: 25rpx;
  color: #777;
  line-height: 1.6;
  transition: all 0.2s;
}

.option-check-large {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB7B2 0%, #FEE5E6 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 183, 178, 0.3);
}

/* 底部按钮区域 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 25rpx 30rpx 35rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  border-top: 2rpx solid rgba(255, 255, 255, 0.5);
}

.skip-button {
  text-align: center;
  margin-bottom: 18rpx;
}

.skip-text {
  color: #999;
  font-size: 26rpx;
  padding: 6rpx 0;
  display: inline-block;
  position: relative;
}

.skip-text::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 183, 178, 0.4);
}

.action-buttons {
  display: flex;
  gap: 18rpx;
}

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.8);
  color: #666;
  border: 2rpx solid rgba(255, 183, 178, 0.2);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.9);
}

.btn-primary {
  background: linear-gradient(135deg, #FFB7B2 0%, #FEE5E6 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 178, 0.3);
}

.btn-primary:active {
  background: linear-gradient(135deg, #FF9A94 0%, #FDD4D6 100%);
  transform: translateY(1rpx);
}

.btn-primary.btn-submit {
  flex: 1;
}

.btn-primary::after {
  border: none;
}

.btn-secondary::after {
  border: none;
}