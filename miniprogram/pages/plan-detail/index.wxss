/* plan-detail/index.wxss */
page {
  background-color: #F8F8F8;
}

.container {
  min-height: 100vh;
  padding-bottom: 180rpx;
  padding-top: 88rpx;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 75rpx;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #FFE5F0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.navbar-back {
  position: absolute;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 30rpx;
}

.back-text {
  font-size: 40rpx;
  color: #333333;
  font-weight: 600;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 计划头部 */
.plan-header {
  margin-top: 50px;
  min-width: 80%;
  background: linear-gradient(135deg, #FFE5F0 0%, #FFF8DC 100%);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plan-icon-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.plan-emoji-large {
  font-size: 60rpx;
}

.plan-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 30rpx;
}

.progress-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.ring-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.current-day {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A90E2;
}

.total-days {
  font-size: 24rpx;
  color: #999999;
}

.streak-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.6);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.streak-icon {
  font-size: 28rpx;
}

.streak-text {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* 今日任务 */
.today-task-section {
  padding: 30rpx;
  min-width: 80%;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

/* 完整任务列表 */
.all-tasks-section {
  min-width: 80%;
  padding: 0 30rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-count {
  font-size: 24rpx;
  color: #999999;
  background-color: #F0F0F0;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.tasks-list {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: all 0.3s;
  cursor: pointer;
}

.task-item:active {
  background-color: #F8F8F8;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  background-color: #F8FFF8;
  opacity: 0.8;
}

.task-item.current {
  background-color: #E3F2FD;
}

.task-item.upcoming {
  background-color: #FFFFFF;
}

.task-day-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  position: relative;
  flex-shrink: 0;
}

.task-item.completed .task-day-badge {
  background-color: #51CF66;
}

.task-item.current .task-day-badge {
  background-color: #4A90E2;
}

.task-item.upcoming .task-day-badge {
  background-color: #E0E0E0;
}

.day-number {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.task-item.upcoming .day-number {
  color: #999999;
}

.status-icon {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  font-weight: 700;
  color: #51CF66;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.status-icon.current {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.task-content {
  flex: 1;
}

.task-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.task-item.completed .task-item-title {
  color: #51CF66;
}

.task-item-desc {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-item-type {
  font-size: 22rpx;
  color: #999999;
}

.task-item-duration {
  font-size: 22rpx;
  color: #999999;
}

.task-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
  font-weight: 300;
}

.task-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.task-header {
  margin-bottom: 16rpx;
}

.task-day {
  display: inline-block;
  background-color: #E3F2FD;
  color: #4A90E2;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.task-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 12rpx;
}

.task-type {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.type-icon {
  font-size: 28rpx;
}

.type-text {
  font-size: 26rpx;
  color: #666666;
}

.task-duration {
  font-size: 24rpx;
  color: #999999;
  margin-left: auto;
}

.task-description {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.start-task-btn {
  width: 100%;
  background: linear-gradient(135deg, #4A90E2 0%, #63B3ED 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.start-task-btn::after {
  border: none;
}

.start-task-btn.started {
  background: #51CF66;
  box-shadow: 0 4rpx 16rpx rgba(81, 207, 102, 0.3);
}

.start-task-btn[disabled] {
  opacity: 1;
}

/* 打卡按钮 */
.checkin-section {
  padding: 0 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checkin-btn {
  width: 100%;
  background: linear-gradient(135deg, #FFB6C1 0%, #FFA07A 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255, 182, 193, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.checkin-btn::after {
  border: none;
}

.checkin-btn.disabled {
  background: #E0E0E0;
  box-shadow: none;
}

.checkin-btn[disabled] {
  opacity: 1;
}

.checkin-icon {
  font-size: 36rpx;
}

.checkin-text {
  font-size: 32rpx;
}

.checkin-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 已打卡状态 */
.checked-section {
  padding: 0 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checked-badge {
  background-color: #E8F8F5;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checked-icon {
  font-size: 32rpx;
  color: #51CF66;
}

.checked-text {
  font-size: 28rpx;
  color: #51CF66;
  font-weight: 600;
}

.checked-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 日历 */
.calendar-section {
  padding: 0 30rpx 30rpx;
}

.calendar {
  min-width: 75vw;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.calendar-header {
  text-align: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.calendar-month {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 12rpx 0;
  font-weight: 500;
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  padding: 0 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  position: relative;
  transition: all 0.3s;
}

.day-cell.disabled {
  opacity: 0.2;
}

.day-cell.today {
  background-color: #E3F2FD;
  border: 2rpx solid #4A90E2;
}

.day-cell.checked {
  background: linear-gradient(135deg, #51CF66 0%, #40C057 100%);
  box-shadow: 0 4rpx 12rpx rgba(81, 207, 102, 0.3);
  transform: scale(1.05);
}

.day-number {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  z-index: 1;
}

.day-cell.checked .day-number {
  color: #FFFFFF;
  font-weight: 600;
}

.day-cell.today .day-number {
  color: #4A90E2;
  font-weight: 600;
}

.check-mark {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  color: #51CF66;
  font-weight: 700;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 调整计划 */
.adjust-section {
  padding: 0 30rpx 30rpx;
}

.adjust-btn {
  width: 100%;
  background-color: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 50rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.adjust-btn::after {
  border: none;
}

.adjust-icon {
  font-size: 28rpx;
}

.adjust-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

/* 任务详情弹窗 */
.task-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #FFE5F0 0%, #FFF8DC 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.modal-day-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  position: relative;
}

.modal-day-badge.completed {
  background-color: #E8F8F5;
}

.modal-day-badge.current {
  background-color: #E3F2FD;
}

.modal-day-badge.upcoming {
  background-color: #F5F5F5;
}

.modal-day-number {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.modal-status-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #51CF66;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.modal-status-icon.current {
  background-color: #4A90E2;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666666;
  font-weight: 300;
}

.modal-body {
  padding: 40rpx 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.modal-type {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.modal-type-icon {
  font-size: 32rpx;
}

.modal-type-name {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.modal-duration {
  font-size: 24rpx;
  color: #999999;
  margin-left: auto;
}

.modal-description-section {
  margin-bottom: 32rpx;
}

.modal-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.modal-description {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.modal-status-section {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
}

.modal-status-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 12rpx;
}

.modal-status-text {
  font-size: 26rpx;
  font-weight: 600;
}

.modal-status-text.completed {
  color: #51CF66;
}

.modal-status-text.current {
  color: #4A90E2;
}

.modal-status-text.upcoming {
  color: #999999;
}

.modal-footer {
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-btn {
  width: 100%;
  background: linear-gradient(135deg, #4A90E2 0%, #63B3ED 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.modal-btn::after {
  border: none;
}
