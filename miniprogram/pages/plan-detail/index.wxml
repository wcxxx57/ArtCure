<!--plan-detail/index.wxml-->
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="navbar-back" bindtap="onBack">
      <text class="back-text">←</text>
    </view>
    <text class="navbar-title">计划详情</text>
  </view>

  <!-- 顶部计划信息 -->
  <view class="plan-header">
    <view class="plan-icon-large" style="background-color: {{planInfo.bgColor}}">
      <text class="plan-emoji-large">{{planInfo.emoji}}</text>
    </view>
    <text class="plan-name">{{planInfo.name}}</text>
    
    <!-- 进度环 -->
    <view class="progress-ring">
      <view class="ring-content">
        <text class="current-day">{{planInfo.currentDay}}</text>
        <text class="total-days">/{{planInfo.totalDays}}天</text>
      </view>
    </view>
    
    <view class="streak-info">
      <text class="streak-icon">🔥</text>
      <text class="streak-text">连续打卡 {{planInfo.streak}} 天</text>
    </view>
  </view>

  <!-- 今日任务卡片 -->
  <view class="today-task-section">
    <text class="section-title">今日任务</text>
    <view class="task-card">
      <view class="task-header">
        <text class="task-day">第{{planInfo.currentDay + 1}}天</text>
        <text class="task-title">{{todayTask.title}}</text>
      </view>
      <view class="task-type">
        <text class="type-icon">{{todayTask.typeIcon}}</text>
        <text class="type-text">{{todayTask.typeName}}</text>
        <text class="task-duration">{{todayTask.duration}}分钟</text>
      </view>
      <text class="task-description">{{todayTask.content || todayTask.description}}</text>
      
      <button 
        class="start-task-btn {{todayTask.started ? 'started' : ''}}" 
        bindtap="onStartTask"
        disabled="{{todayTask.started || planInfo.todayChecked}}"
        wx:if="{{!planInfo.todayChecked}}"
      >
        {{todayTask.started ? '✓ 已完成' : '开始任务'}}
      </button>
    </view>
  </view>

  <!-- 完整任务列表 -->
  <view class="all-tasks-section">
    <view class="section-header">
      <text class="section-title">完整计划</text>
      <text class="task-count">共{{planInfo.totalDays}}天</text>
    </view>
    <view class="tasks-list">
      <view 
        class="task-item {{index < planInfo.currentDay ? 'completed' : index === planInfo.currentDay ? 'current' : 'upcoming'}}"
        wx:for="{{planInfo.tasks}}"
        wx:key="day"
        data-index="{{index}}"
        bindtap="onViewTaskDetail"
      >
        <view class="task-day-badge">
          <text class="day-number">{{item.day}}</text>
          <view class="status-icon" wx:if="{{index < planInfo.currentDay}}">✓</view>
          <view class="status-icon current" wx:elif="{{index === planInfo.currentDay}}">●</view>
        </view>
        <view class="task-content">
          <text class="task-item-title">{{item.title}}</text>
          <text class="task-item-desc">{{item.description || item.content}}</text>
          <view class="task-meta">
            <text class="task-item-type" wx:if="{{item.typeIcon}}">{{item.typeIcon}} {{item.typeName}}</text>
            <text class="task-item-duration">{{item.duration}}分钟</text>
          </view>
        </view>
        <view class="task-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 打卡按钮 -->
  <view class="checkin-section" wx:if="{{!planInfo.todayChecked}}">
    <button 
      class="checkin-btn {{todayTask.started ? 'active' : 'disabled'}}" 
      bindtap="onCheckIn"
      disabled="{{!todayTask.started}}"
    >
      <text class="checkin-icon">✓</text>
      <text class="checkin-text">完成打卡</text>
    </button>
    <text class="checkin-tip">完成任务后即可打卡</text>
  </view>

  <!-- 已打卡提示 -->
  <view class="checked-section" wx:else>
    <view class="checked-badge">
      <text class="checked-icon">✓</text>
      <text class="checked-text">今日已打卡</text>
    </view>
    <text class="checked-tip">明天继续加油！</text>
  </view>

  <!-- 日历视图 -->
  <view class="calendar-section">
    <text class="section-title">本月打卡</text>
    <view class="calendar">
      <view class="calendar-header">
        <text class="calendar-month">{{currentMonth}}</text>
      </view>
      <view class="calendar-weekdays">
        <text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="calendar-days">
        <view 
          class="day-cell {{item.isToday ? 'today' : ''}} {{item.checked ? 'checked' : ''}} {{item.disabled ? 'disabled' : ''}}"
          wx:for="{{calendarDays}}"
          wx:key="index"
        >
          <text class="day-number">{{item.day}}</text>
          <view class="check-mark" wx:if="{{item.checked}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 计划调整入口 -->
  <view class="adjust-section">
    <button class="adjust-btn" bindtap="onAdjustPlan">
      <text class="adjust-icon">⚙️</text>
      <text class="adjust-text">调整计划</text>
    </button>
  </view>

  <!-- 任务详情弹窗 -->
  <view class="task-detail-modal" wx:if="{{showTaskDetail}}" bindtap="onCloseTaskDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-day-badge {{selectedTask.status}}">
          <text class="modal-day-number">第{{selectedTask.day}}天</text>
          <view class="modal-status-icon" wx:if="{{selectedTask.status === 'completed'}}">✓</view>
          <view class="modal-status-icon current" wx:elif="{{selectedTask.status === 'current'}}">●</view>
        </view>
        <view class="modal-close" bindtap="onCloseTaskDetail">✕</view>
      </view>
      
      <view class="modal-body">
        <text class="modal-title">{{selectedTask.title}}</text>
        
        <view class="modal-type" wx:if="{{selectedTask.typeIcon}}">
          <text class="modal-type-icon">{{selectedTask.typeIcon}}</text>
          <text class="modal-type-name">{{selectedTask.typeName}}</text>
          <text class="modal-duration">{{selectedTask.duration}}分钟</text>
        </view>
        
        <view class="modal-description-section">
          <text class="modal-section-title">任务描述</text>
          <text class="modal-description">{{selectedTask.description || selectedTask.content || '暂无描述'}}</text>
        </view>
        
        <view class="modal-status-section">
          <text class="modal-status-label">状态：</text>
          <text class="modal-status-text completed" wx:if="{{selectedTask.status === 'completed'}}">✓ 已完成</text>
          <text class="modal-status-text current" wx:elif="{{selectedTask.status === 'current'}}">● 进行中</text>
          <text class="modal-status-text upcoming" wx:else>待完成</text>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="modal-btn" bindtap="onCloseTaskDetail">关闭</button>
      </view>
    </view>
  </view>
</view>
