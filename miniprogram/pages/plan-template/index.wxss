/* plan-template/index.wxss */
page {
  background-color: #F8F8F8;
}

.container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 200rpx;
  padding-top: 120rpx;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #FFE5F0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.navbar-back {
  position: absolute;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 30rpx;
}

.back-text {
  font-size: 40rpx;
  color: #333333;
  font-weight: 600;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 计划信息卡片 */
.plan-info-card {
  background: linear-gradient(135deg, #FFE5F0 0%, #FFF8DC 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 182, 193, 0.2);
  width: 90%;
  margin-left: auto;
  margin-right: auto;
}

.plan-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.plan-emoji {
  font-size: 60rpx;
}

.plan-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.plan-description {
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.plan-meta {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666666;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.tag {
  background-color: rgba(255, 255, 255, 0.6);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666666;
}

/* 任务列表 */
.tasks-section {
  margin-bottom: 30rpx;
  min-width: 100%;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.section-tip {
  font-size: 22rpx;
  color: #999999;
}

.tasks-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.task-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.task-day-badge {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #63B3ED 100%);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.day-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.task-info {
  flex: 1;
}

.task-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.task-type {
  font-size: 22rpx;
  color: #666666;
}

.task-duration {
  font-size: 22rpx;
  color: #999999;
}

.task-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-icon {
  font-size: 28rpx;
  padding: 8rpx;
}

.expand-icon {
  font-size: 20rpx;
  color: #999999;
}

.task-content {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #F5F5F5;
  padding-top: 20rpx;
}

.task-description {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  border: none;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn::after {
  border: none;
}

.default-btn {
  background-color: #F5F5F5;
  color: #666666;
}

.custom-btn {
  background: linear-gradient(135deg, #FFB6C1 0%, #FFA07A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.3);
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 8rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background-color: #F5F5F5;
  color: #666666;
}

.confirm-btn {
  background-color: #FFB6C1;
  color: #FFFFFF;
}
