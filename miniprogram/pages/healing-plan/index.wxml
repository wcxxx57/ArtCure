<!--healing-plan/index.wxml-->
<view class="page-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">疗愈计划</text>
    <text class="page-subtitle">坚持练习，看见改变的发生</text>
  </view>

  <!-- 心情专属推荐 -->
  <view class="mood-recommend-section" wx:if="{{isLogin}}">
    <view class="recommend-header">
      <view class="recommend-title-area">
        <text class="recommend-sparkle">✨</text>
        <text class="recommend-title">为你推荐</text>
      </view>
      <view class="recommend-actions">
        <view class="recommend-refresh" bindtap="onRefreshRecommendations">
          <text class="refresh-icon">🔄</text>
        </view>
        <view class="recommend-test" bindtap="onTestAIGeneration">
          <text class="test-icon">🤖</text>
        </view>
      </view>
    </view>
    
    <!-- 推荐来源提示 -->
    <view class="recommend-source-badge" wx:if="{{recommendationSource === 'rule'}}">
      <text class="badge-icon">⏳</text>
      <text class="badge-text">正在为你生成个性化推荐...</text>
    </view>
    <view class="recommend-source-badge ai" wx:elif="{{recommendationSource === 'cache-ai'}}">
      <text class="badge-icon">🤖</text>
      <text class="badge-text">AI专属推荐</text>
    </view>
    <view class="recommend-source-badge fallback" wx:elif="{{recommendationSource === 'fallback'}}">
      <text class="badge-icon">💡</text>
      <text class="badge-text">基础推荐</text>
    </view>
    
    <!-- 推荐加载状态 -->
    <view class="recommend-loading" wx:if="{{!showRecommendations && recommendations.length === 0}}">
      <view class="loading-animation">
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
      </view>
      <text class="loading-text">正在加载推荐...</text>
    </view>
    
    <!-- 推荐卡片 -->
    <view class="recommend-card-wrapper" wx:if="{{showRecommendations && recommendations.length > 0}}">
      <view 
        class="recommend-card-beautiful"
        bindtap="onRecommendationTap"
        data-recommendation="{{recommendations[0]}}"
        style="background: linear-gradient(135deg, {{recommendations[0].bgColor}} 0%, {{recommendations[0].bgColor}}dd 100%)"
      >
        <!-- 装饰元素 -->
        <view class="card-decoration">
          <view class="deco-circle deco-1"></view>
          <view class="deco-circle deco-2"></view>
          <view class="deco-sparkle">✨</view>
        </view>
        
        <!-- 卡片内容 -->
        <view class="card-content-area">
          <view class="card-icon-large">
            <text class="icon-emoji">{{recommendations[0].icon}}</text>
          </view>
          
          <view class="card-text-area">
            <text class="card-title">{{recommendations[0].title}}</text>
            <text class="card-description">{{recommendations[0].description}}</text>
            <text class="card-reason">{{recommendations[0].reason}}</text>
          </view>
          
          <view class="card-meta-info">
            <view class="meta-item">
              <text class="meta-icon">📅</text>
              <text class="meta-text">{{recommendations[0].days}}天计划</text>
            </view>
            <view class="meta-item">
              <text class="meta-icon">⏱️</text>
              <text class="meta-text">{{recommendations[0].duration}}分钟/天</text>
            </view>
          </view>
          
          <view class="card-action-btn">
            <text class="btn-text">查看详情</text>
            <text class="btn-arrow">→</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的计划入口 -->
  <view class="my-plans-entry" wx:if="{{isLogin}}" bindtap="onMyPlansEntryTap">
    <view class="entry-icon">📋</view>
    <view class="entry-content">
      <text class="entry-title">我的计划</text>
      <text class="entry-desc">查看所有已加入的计划</text>
    </view>
    <view class="entry-arrow">→</view>
  </view>

  <!-- 我的计划 -->
  <view class="my-plans-section" wx:if="{{myPlans.length > 0}}">
    <text class="section-title">进行中的计划</text>
    <view class="my-plans-list">
      <view 
        class="my-plan-card"
        wx:for="{{myPlans}}"
        wx:key="id"
        bindtap="onMyPlanTap"
        data-plan="{{item}}"
      >
        <view class="plan-icon" style="background-color: {{item.bgColor}}">
          <text class="plan-emoji">{{item.emoji}}</text>
        </view>
        <view class="plan-info">
          <text class="plan-title">{{item.title}}</text>
          <view class="plan-progress-bar">
            <view class="progress-fill" style="width: {{item.progress}}%"></view>
          </view>
          <text class="plan-progress-text">已完成{{item.currentDay}}天/共{{item.totalDays}}天</text>
        </view>
        <view class="plan-action">
          <text class="action-text">继续</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 经典方案 -->
  <view class="classic-section">
    <text class="section-title">经典方案</text>
    <view class="classic-list">
      <view 
        class="classic-card"
        wx:for="{{classicPlans}}"
        wx:key="id"
        bindtap="onClassicPlanTap"
        data-plan="{{item}}"
      >
        <view class="classic-icon" style="background-color: {{item.bgColor}}">
          <text class="classic-emoji">{{item.emoji}}</text>
        </view>
        <view class="classic-info">
          <text class="classic-title">{{item.title}}</text>
          <view class="classic-tags">
            <text class="classic-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">#{{tag}}</text>
          </view>
        </view>
        <view class="classic-arrow">
          <text>›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 定制计划入口 -->
  <view class="custom-section">
    <view class="custom-card" bindtap="onCustomPlanTap">
      <view class="custom-icon">🪄</view>
      <view class="custom-content">
        <text class="custom-title">定制专属计划</text>
        <text class="custom-desc">告诉AI你的需求，生成个性化疗愈计划</text>
      </view>
      <view class="custom-arrow">→</view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space"></view>
</view>
