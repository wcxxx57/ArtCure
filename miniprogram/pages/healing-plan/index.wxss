/* healing-plan/index.wxss - 疗愈计划 */
page {
  background-color: #FFFFFF;
}

.page-container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 180rpx;
}

/* ==================== 页面头部 ==================== */
.page-header {
  padding: 40rpx 40rpx 24rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

/* ==================== 心情专属推荐 ==================== */
.mood-recommend-section {
  padding: 0 32rpx 32rpx;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.recommend-title-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.recommend-sparkle {
  font-size: 32rpx;
  animation: sparkle 2s ease-in-out infinite;
}

@keyframes sparkle {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.2); }
}

.recommend-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.recommend-actions {
  display: flex;
  gap: 12rpx;
}

.recommend-refresh,
.recommend-test {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F8F8F8;
  border-radius: 50%;
  transition: all 0.3s;
}

.recommend-refresh:active,
.recommend-test:active {
  transform: scale(0.9);
}

.recommend-test {
  background-color: #E3F2FD;
}

.refresh-icon,
.test-icon {
  font-size: 24rpx;
}

/* 推荐来源标签 */
.recommend-source-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #FFF8DC;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.recommend-source-badge.ai {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
}

.recommend-source-badge.fallback {
  background-color: #F0F4C3;
}

.badge-icon {
  font-size: 20rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* 加载动画 */
.recommend-loading {
  background: linear-gradient(135deg, #FFF8DC 0%, #FFE5F0 100%);
  padding: 60rpx 32rpx;
  border-radius: 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-animation {
  display: flex;
  gap: 12rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #FFB6C1;
  animation: bounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* 推荐卡片 */
.recommend-card-wrapper {
  position: relative;
}

.recommend-card-beautiful {
  position: relative;
  border-radius: 32rpx;
  padding: 40rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s;
}

.recommend-card-beautiful:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 装饰元素 */
.card-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

.deco-1 {
  width: 120rpx;
  height: 120rpx;
  top: -40rpx;
  right: 40rpx;
  animation: float 6s ease-in-out infinite;
}

.deco-2 {
  width: 80rpx;
  height: 80rpx;
  bottom: 20rpx;
  left: 20rpx;
  animation: float 8s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

.deco-sparkle {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 40rpx;
  animation: sparkle 3s ease-in-out infinite;
}

/* 卡片内容 */
.card-content-area {
  position: relative;
  z-index: 1;
}

.card-icon-large {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.icon-emoji {
  font-size: 56rpx;
}

.card-text-area {
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.card-description {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.card-reason {
  display: block;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  font-style: italic;
}

.card-meta-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.7);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.card-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background-color: rgba(0, 0, 0, 0.85);
  padding: 24rpx 40rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.btn-arrow {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ==================== AI 推荐卡片（保留原样式作为备用） ==================== */
.ai-recommend-section {
  padding: 0 32rpx 32rpx;
}

.ai-recommend-card {
  background: linear-gradient(135deg, #FFF0F5 0%, #F3E5F5 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.ai-sparkle {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 48rpx;
}

.ai-recommend-badge {
  display: inline-block;
  background-color: rgba(255, 255, 255, 0.6);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #9C27B0;
  margin-bottom: 16rpx;
}

.ai-recommend-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.ai-recommend-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 24rpx;
  max-width: 80%;
}

.ai-recommend-btn {
  display: inline-block;
  background-color: #333333;
  color: #FFFFFF;
  padding: 20rpx 48rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* ==================== 我的计划入口 ==================== */
.my-plans-entry {
  margin: 0 32rpx 32rpx;
  background: linear-gradient(135deg, #E8F8F5 0%, #B2EBF2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.entry-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.entry-content {
  flex: 1;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 6rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: #666666;
}

.entry-arrow {
  font-size: 32rpx;
  color: #4A90E2;
  font-weight: 600;
}

/* ==================== 我的计划 ==================== */
.my-plans-section {
  padding: 0 32rpx 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.my-plans-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.my-plan-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F5F5F5;
}

.plan-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plan-emoji {
  font-size: 48rpx;
}

.plan-info {
  flex: 1;
  margin-left: 20rpx;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.plan-progress-bar {
  height: 8rpx;
  background-color: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2 0%, #63B3ED 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.plan-progress-text {
  font-size: 22rpx;
  color: #999999;
}

.plan-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: #E3F2FD;
  border-radius: 20rpx;
}

.action-text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 500;
}

.action-arrow {
  font-size: 24rpx;
  color: #4A90E2;
}

/* ==================== 经典方案 ==================== */
.classic-section {
  padding: 0 32rpx 32rpx;
}

.classic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.classic-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F5F5F5;
}

.classic-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.classic-emoji {
  font-size: 40rpx;
}

.classic-info {
  flex: 1;
  margin-left: 20rpx;
}

.classic-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 10rpx;
}

.classic-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.classic-tag {
  font-size: 22rpx;
  color: #999999;
  background-color: #F8F8F8;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

.classic-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* ==================== 定制计划入口 ==================== */
.custom-section {
  padding: 0 32rpx 32rpx;
}

.custom-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.custom-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.custom-content {
  flex: 1;
}

.custom-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 6rpx;
}

.custom-desc {
  font-size: 24rpx;
  color: #666666;
}

.custom-arrow {
  font-size: 32rpx;
  color: #4A90E2;
  font-weight: 600;
}

/* ==================== 底部占位 ==================== */
.bottom-space {
  height: 40rpx;
}
