<!--profile/index.wxml-->
<view class="page-container">
  <!-- 顶部背景区域 -->
  <view class="header-bg">
    <!-- 用户信息区域 -->
    <view class="user-header">
      <view class="user-main" bindtap="{{isLogin ? 'onUserHeaderTap' : ''}}">
        <view class="avatar-wrapper">
          <image class="avatar" src="{{userInfo.avatar || '/images/avatar.png'}}"></image>
        </view>
        <view class="user-details">
          <text class="username">{{userInfo.nickname || '点击登录'}}</text>
          <view class="user-status" wx:if="{{isLogin}}">
            <view class="status-badge mood-badge">
              <view class="status-dot"></view>
              <text>心情平稳</text>
            </view>
            <view class="status-badge coin-badge">
              <text>🪙 {{stats.points}} 金币</text>
            </view>
          </view>
          <text class="user-desc" wx:else>开启你的疗愈之旅</text>
        </view>
      </view>
      <view class="header-actions">
        <view class="login-btn" wx:if="{{!isLogin}}" bindtap="onLoginTap">
          <text>登录</text>
        </view>
        <view class="settings-btn" wx:else bindtap="onSettingsTap">
          <text class="settings-icon">⚙️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 心情曲线卡片 -->
  <view class="mood-curve-section" wx:if="{{isLogin}}">
    <view class="mood-curve-card">
      <view class="curve-header">
        <text class="curve-title">心情曲线</text>
        <picker mode="selector" range="{{['本周', '本月']}}" bindchange="onPeriodChange">
          <view class="period-selector">
            <text>{{currentPeriod}}</text>
            <text class="period-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="curve-chart">
        <!-- 背景网格线 -->
        <view class="chart-lines">
          <view class="chart-line"></view>
          <view class="chart-line"></view>
          <view class="chart-line"></view>
        </view>
        <!-- 心情曲线点 -->
        <view class="chart-curve">
          <view 
            wx:for="{{chartPoints}}" 
            wx:key="index"
            class="curve-point {{item.value ? '' : 'curve-point-empty'}} {{index === chartPoints.length - 1 ? 'active' : ''}}" 
            style="left: {{item.x}}%; bottom: {{item.y || 30}}%"
            wx:if="{{item.value}}"
          >
            <view class="point-tooltip" wx:if="{{item.emoji}}">
              <text>{{item.emoji}}</text>
            </view>
          </view>
          <!-- 无数据提示 -->
          <view class="no-data-tip" wx:if="{{chartPoints.length === 0}}">
            <text>暂无心情数据</text>
          </view>
        </view>
      </view>
      <view class="chart-labels">
        <text wx:if="{{currentPeriod === '本周'}}">周一</text>
        <text wx:if="{{currentPeriod === '本周'}}">周三</text>
        <text wx:if="{{currentPeriod === '本周'}}">周五</text>
        <text wx:if="{{currentPeriod === '本周'}}">周日</text>
        <text wx:if="{{currentPeriod === '本月'}}">30天前</text>
        <text wx:if="{{currentPeriod === '本月'}}">20天前</text>
        <text wx:if="{{currentPeriod === '本月'}}">10天前</text>
        <text wx:if="{{currentPeriod === '本月'}}">今天</text>
      </view>
      
      <!-- 心情分析区域 -->
      <view class="mood-analysis-section" wx:if="{{moodAnalysis}}">
        <view class="analysis-toggle" bindtap="onToggleAnalysis">
          <text class="analysis-title">智能心情分析</text>
          <text class="toggle-icon">{{showMoodAnalysis ? '▲' : '▼'}}</text>
        </view>
        
        <view class="analysis-content" wx:if="{{showMoodAnalysis}}">
          <!-- 趋势分析 -->
          <view class="analysis-item">
            <view class="analysis-header">
              <text class="analysis-icon">{{moodAnalysis.trendIcon}}</text>
              <text class="analysis-label">心情趋势</text>
            </view>
            <text class="analysis-value" style="color: {{moodAnalysis.trendColor}}">{{moodAnalysis.description}}</text>
          </view>
          
          <!-- 平均心情 -->
          <view class="analysis-item">
            <view class="analysis-header">
              <text class="analysis-icon">📊</text>
              <text class="analysis-label">平均心情</text>
            </view>
            <text class="analysis-value">{{moodAnalysis.avgMood}}分 ({{moodAnalysis.stabilityText}})</text>
          </view>
          
          <!-- 记录统计 -->
          <view class="analysis-item">
            <view class="analysis-header">
              <text class="analysis-icon">📝</text>
              <text class="analysis-label">记录统计</text>
            </view>
            <text class="analysis-value">{{moodAnalysis.totalRecords}}次记录，范围{{moodAnalysis.moodRange[0]}}-{{moodAnalysis.moodRange[1]}}分</text>
          </view>
          
          <!-- 心情分布 -->
          <view class="mood-distribution">
            <text class="distribution-title">心情分布</text>
            <view class="distribution-bars">
              <view class="distribution-item" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
                <view class="bar-container">
                  <view class="mood-bar" style="height: {{(moodAnalysis.moodDistribution[item] / moodAnalysis.totalRecords) * 100}}%"></view>
                </view>
                <text class="bar-label">{{item}}分</text>
                <text class="bar-count">{{moodAnalysis.moodDistribution[item]}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-section">
    <view class="stat-card">
      <view class="stat-icon" style="background-color: #E3F2FD">
        <text>⏱️</text>
      </view>
      <view class="stat-info">
        <text class="stat-number">{{stats.totalHours || 0}}h</text>
        <text class="stat-label">累计疗愈</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon" style="background-color: #FEE5E6">
        <text>📅</text>
      </view>
      <view class="stat-info">
        <text class="stat-number">{{stats.days}}</text>
        <text class="stat-label">疗愈天数</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单列表 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="onMenuTap" data-page="/pages/my-orders/index">
        <view class="menu-left">
          <text class="menu-icon">📋</text>
          <text class="menu-title">我的订单</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="onMenuTap" data-page="/pages/my-appointments/index">
        <view class="menu-left">
          <text class="menu-icon">📆</text>
          <text class="menu-title">预约记录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="onMenuTap" data-page="/pages/coin-detail/index">
        <view class="menu-left">
          <text class="menu-icon">🪙</text>
          <text class="menu-title">金币明细</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      
      <!-- 问卷入口（仅未完成时显示） -->
      <view class="menu-item" wx:if="{{isLogin && !hasCompletedSurvey}}" bindtap="onSurveyTap">
        <view class="menu-left">
          <text class="menu-icon">📝</text>
          <text class="menu-title">完善个人偏好</text>
          <view class="menu-badge">未完成</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="onMenuTap" data-page="/pages/feedback/index">
        <view class="menu-left">
          <text class="menu-icon">💬</text>
          <text class="menu-title">建议反馈</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="onMenuTap" data-page="/pages/about/index">
        <view class="menu-left">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-title">关于我们</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" wx:if="{{isLogin}}" bindtap="onMenuTap" data-page="/pages/settings/index">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-title">账户设置</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section" wx:if="{{isLogin}}">
      <view class="logout-btn" bindtap="onLogoutTap">
        <text>退出登录</text>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space"></view>
</view>
