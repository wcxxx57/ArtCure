<!--profile/index.wxml-->
<view class="container">
  <!-- 顶部用户信息区域 -->
  <view class="user-header">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar || '/miniprogram/images/avatar.png'}}"></image>
      <view class="user-details">
        <text class="username">{{userInfo.nickname || '未登录'}}</text>
        <text class="user-desc">{{userInfo.desc || '点击登录，开启疗愈之旅'}}</text>
      </view>
    </view>
    <view class="login-btn" wx:if="{{!isLogin}}" bindtap="onLoginTap">
      <text>登录/注册</text>
    </view>
  </view>

  <!-- 个人统计信息 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-number">{{stats.days}}</text>
      <text class="stat-label">疗愈天数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{stats.sessions}}</text>
      <text class="stat-label">完成课程</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{stats.points}}</text>
      <text class="stat-label">积分</text>
    </view>
  </view>

  <!-- 功能菜单列表 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onMenuTap" data-page="/pages/my-plan/index">
      <view class="menu-left">
        <image class="menu-icon" src="/miniprogram/images/icons/goods.png"></image>
        <text class="menu-title">我的计划</text>
      </view>
      <image class="menu-arrow" src="/miniprogram/images/arrow.svg"></image>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-page="/pages/my-records/index">
      <view class="menu-left">
        <image class="menu-icon" src="/miniprogram/images/icons/examples.png"></image>
        <text class="menu-title">疗愈记录</text>
      </view>
      <image class="menu-arrow" src="/miniprogram/images/arrow.svg"></image>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-page="/pages/my-favorites/index">
      <view class="menu-left">
        <image class="menu-icon" src="/miniprogram/images/icons/business.png"></image>
        <text class="menu-title">我的收藏</text>
      </view>
      <image class="menu-arrow" src="/miniprogram/images/arrow.svg"></image>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onMenuTap" data-page="/pages/settings/index">
      <view class="menu-left">
        <image class="menu-icon" src="/miniprogram/images/icons/setting.svg"></image>
        <text class="menu-title">设置</text>
      </view>
      <image class="menu-arrow" src="/miniprogram/images/arrow.svg"></image>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-page="/pages/about/index">
      <view class="menu-left">
        <image class="menu-icon" src="/miniprogram/images/icons/question.svg"></image>
        <text class="menu-title">关于我们</text>
      </view>
      <image class="menu-arrow" src="/miniprogram/images/arrow.svg"></image>
    </view>

    <view class="menu-item" wx:if="{{isLogin}}" bindtap="onLogoutTap">
      <view class="menu-left">
        <image class="menu-icon" src="/miniprogram/images/icons/close.png"></image>
        <text class="menu-title">退出登录</text>
      </view>
      <image class="menu-arrow" src="/miniprogram/images/arrow.svg"></image>
    </view>
  </view>
</view>
