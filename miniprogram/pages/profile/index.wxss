/* profile/index.wxss - 个人中心 */
page {
  background-color: #F8F9FA;
}

.page-container {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 180rpx;
}

/* ==================== 顶部背景区域 ==================== */
.header-bg {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  padding-top: calc(160rpx + env(safe-area-inset-top));
  padding-bottom: 100rpx;
  border-radius: 0 0 60rpx 60rpx;
  position: relative;
}

/* ==================== 用户信息区域 ==================== */
.user-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 40rpx;
}

.user-main {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  padding: 6rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-details {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.user-status {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.mood-badge {
  background-color: rgba(255, 255, 255, 0.5);
  color: #666666;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #4CAF50;
}

.coin-badge {
  background-color: #FFF9C4;
  color: #F57C00;
  font-weight: 600;
}

.user-desc {
  font-size: 26rpx;
  color: #666666;
}

.header-actions {
  display: flex;
  align-items: center;
}

.login-btn {
  background-color: #FFFFFF;
  padding: 14rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-top: 40rpx;
}

.login-btn text {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 600;
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  font-size: 32rpx;
}

/* ==================== 心情曲线卡片 ==================== */
.mood-curve-section {
  margin: -60rpx 32rpx 24rpx;
  position: relative;
  z-index: 10;
}

.mood-curve-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 226, 0.12);
}

.curve-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.curve-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.period-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F8F8F8;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
}

.period-selector text {
  font-size: 24rpx;
  color: #666666;
}

.period-arrow {
  font-size: 18rpx !important;
  color: #999999 !important;
}

.curve-chart {
  height: 200rpx;
  position: relative;
  margin-bottom: 16rpx;
}

.chart-lines {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chart-line {
  height: 2rpx;
  background-color: #F5F5F5;
}

.chart-curve {
  position: absolute;
  inset: 0;
}

.curve-point {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background-color: #FFFFFF;
  border: 4rpx solid #FFB7B2;
  border-radius: 50%;
  transform: translate(-50%, 50%);
  transition: all 0.3s ease;
}

.curve-point.active {
  width: 20rpx;
  height: 20rpx;
  border-width: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 183, 178, 0.4);
}

.curve-point-empty {
  background-color: #F5F5F5;
  border-color: #E0E0E0;
}

.point-tooltip {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.no-data-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #CCCCCC;
  font-size: 24rpx;
}

/* ==================== 心情分析 ==================== */
.mood-analysis-section {
  margin-top: 32rpx;
  border-top: 2rpx solid #F5F5F5;
  padding-top: 24rpx;
}

.analysis-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.toggle-icon {
  font-size: 20rpx;
  color: #999999;
}

.analysis-content {
  margin-top: 16rpx;
}

.analysis-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}

.analysis-item:last-child {
  border-bottom: none;
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.analysis-icon {
  font-size: 24rpx;
}

.analysis-label {
  font-size: 26rpx;
  color: #666666;
}

.analysis-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
}

.mood-distribution {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F8F8F8;
}

.distribution-title {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

.distribution-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 120rpx;
  padding: 0 16rpx;
}

.distribution-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-container {
  height: 80rpx;
  width: 24rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  margin-bottom: 8rpx;
}

.mood-bar {
  width: 100%;
  background: linear-gradient(180deg, #FFB7B2 0%, #FF8A80 100%);
  border-radius: 12rpx;
  min-height: 4rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.bar-count {
  font-size: 18rpx;
  color: #CCCCCC;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.chart-labels text {
  font-size: 20rpx;
  color: #CCCCCC;
}

/* ==================== 统计数据 ==================== */
.stats-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 32rpx 24rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-icon text {
  font-size: 32rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* ==================== 功能菜单 ==================== */
.menu-section {
  padding: 0 32rpx;
}

.menu-group {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #F8F8F8;
  transition: background-color 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #FAFAFA;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ==================== 退出登录 ==================== */
.logout-section {
  padding: 40rpx 0;
}

.logout-btn {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.logout-btn text {
  font-size: 30rpx;
  color: #FF6B6B;
  font-weight: 500;
}

/* ==================== 底部占位 ==================== */
.bottom-space {
  height: 40rpx;
}

/* 问卷入口徽章 */
.menu-badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: white;
  font-size: 20rpx;
  border-radius: 20rpx;
  vertical-align: middle;
}
