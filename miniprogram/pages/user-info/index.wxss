/* user-info/index.wxss */
page {
  background-color: #F8F9FA;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头像区域 */
.avatar-section {
  min-width: 75%;
  margin-top: 5%;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  padding: 60rpx 30rpx 50rpx;
  border-radius: 0 0 48rpx 48rpx;
}

.avatar-container {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

/* 左侧头像 */
.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.25);
  display: block;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.avatar-wrapper:active .avatar-mask {
  opacity: 1;
}

.camera-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 右侧昵称区域 */
.nickname-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nickname-label {
  font-size: 24rpx;
  color: #666666;
}

.nickname-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 10rpx;
}

.edit-nickname-btn {
  width: 200rpx;
  height: 64rpx;
  background-color: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  line-height: 64rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.edit-nickname-btn::after {
  border: none;
}

.edit-icon {
  width: 28rpx;
  height: 28rpx;
}

.edit-nickname-btn text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 500;
}

/* 上传进度 */
.upload-progress {
  margin-top: 30rpx;
}

.progress-bar {
  height: 8rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2 0%, #63B3ED 100%);
  transition: width 0.3s;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
}

/* 信息列表 */
.info-section {
  min-width: 80%;
  margin: 30rpx 30rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #F8F8F8;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item.clickable:active {
  background-color: #FAFAFA;
}

.item-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.item-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.item-value {
  display: flex;
  align-items: center;
}

.account-text {
  font-size: 28rpx;
  color: #666666;
}

.password-text {
  font-size: 28rpx;
  color: #999999;
  margin-right: 12rpx;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  transform: rotate(180deg);
  opacity: 0.4;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 620rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #F5F5F5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.modal-close {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

.modal-body {
  padding: 32rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.input-wrapper {
  background-color: #F8F8F8;
  border-radius: 20rpx;
  padding: 0 25rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: #4A90E2;
  background-color: #FFFFFF;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 15rpx;
  opacity: 0.5;
}

/* 密码强度 */
.password-strength {
  margin-top: 16rpx;
}

.strength-bar {
  height: 8rpx;
  background-color: #F5F5F5;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.strength-fill {
  height: 100%;
  transition: width 0.3s, background-color 0.3s;
  border-radius: 4rpx;
}

.strength-fill.strength-1 {
  background-color: #FF6B6B;
}

.strength-fill.strength-2 {
  background-color: #FFA500;
}

.strength-fill.strength-3 {
  background-color: #4CAF50;
}

.strength-text {
  font-size: 22rpx;
  color: #999999;
}

.modal-footer {
  padding: 20rpx 32rpx 32rpx;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  line-height: 88rpx;
  padding: 0;
  font-weight: 500;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background-color: #F5F5F5;
  color: #666666;
}

.confirm-btn {
  background: linear-gradient(135deg, #4A90E2 0%, #63B3ED 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.confirm-btn[disabled] {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  box-shadow: none;
}
