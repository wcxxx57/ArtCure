<!--healing-activities/index.wxml-->
<view class="page-container">
  <view class="page-header">
    <view class="header-back" bindtap="onBack">
      <text>‹</text>
    </view>
    <text class="page-title">疗愈活动</text>
  </view>

  <view class="tabs">
    <view class="tab-item {{activeTab === 'all' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="all">
      <text>全部</text>
    </view>
    <view class="tab-item {{activeTab === 'art' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="art">
      <text>艺术疗愈</text>
    </view>
    <view class="tab-item {{activeTab === 'music' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="music">
      <text>音乐疗愈</text>
    </view>
    <view class="tab-item {{activeTab === 'meditation' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="meditation">
      <text>冥想正念</text>
    </view>
  </view>

  <view class="activities-list">
    <view class="activity-card" wx:for="{{activities}}" wx:key="_id" bindtap="onActivityTap" data-id="{{item._id}}">
      <image class="activity-cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="activity-info">
        <text class="activity-title">{{item.title}}</text>
        <view class="activity-meta">
          <view class="meta-row">
            <text class="meta-icon">📅</text>
            <text>{{item.timeText}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-icon">📍</text>
            <text>{{item.location}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-icon">👥</text>
            <text>{{item.currentParticipants}}/{{item.maxParticipants}}人</text>
          </view>
        </view>
        <view class="activity-footer">
          <text class="activity-price">¥{{item.price}}</text>
          <view class="book-btn">
            <text>立即预约</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
