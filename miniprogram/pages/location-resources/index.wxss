page {
  background: #f5fbf7;
}

.location-page {
  min-height: 100vh;
  color: #263238;
  background: linear-gradient(180deg, #effbf4 0%, #edf8ff 58%, #ffffff 100%);
}

.location-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: calc(88rpx + env(safe-area-inset-top)) 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(245, 251, 247, 0.94);
  backdrop-filter: blur(18rpx);
  border-bottom: 1rpx solid rgba(55, 133, 93, 0.12);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #28724e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(55, 133, 93, 0.12);
  flex-shrink: 0;
}

.header-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #173625;
}

.header-subtitle {
  font-size: 22rpx;
  color: #6a8375;
}

.location-scroll {
  box-sizing: border-box;
  height: 100vh;
  padding: calc(210rpx + env(safe-area-inset-top)) 24rpx 0;
}

.search-panel,
.ai-panel,
.poi-panel,
.resource-panel {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(55, 133, 93, 0.12);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(55, 133, 93, 0.07);
}

.search-panel {
  padding: 30rpx;
}

.search-kicker {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e2f7ea;
  color: #28724e;
  font-size: 22rpx;
  font-weight: 700;
}

.search-title {
  display: block;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #173625;
  line-height: 1.25;
}

.search-desc {
  display: block;
  margin-top: 12rpx;
  color: #5f7469;
  font-size: 26rpx;
  line-height: 1.55;
}

.form-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.form-input {
  flex: 1;
  height: 78rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f2f7f5;
  color: #263238;
  font-size: 26rpx;
}

.city-input {
  max-width: 360rpx;
}

.location-btn,
.search-btn {
  width: 128rpx;
  height: 78rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.location-btn {
  color: #28724e;
  background: #e2f7ea;
}

.search-btn {
  color: #ffffff;
  background: #28724e;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.category-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f7f4;
  color: #5e7468;
  font-size: 24rpx;
}

.category-active {
  color: #ffffff;
  background: #28724e;
}

.ai-panel,
.poi-panel,
.resource-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.ai-title,
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #173625;
  margin-bottom: 14rpx;
}

.ai-text,
.loading-text {
  display: block;
  color: #546b60;
  font-size: 26rpx;
  line-height: 1.6;
}

.loading-text {
  margin-top: 8rpx;
  color: #2e83ad;
}

.search-info-section {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f0f9f4;
  border: 1rpx solid #b9e0cc;
}

.search-params {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 22rpx;
  color: #5f7469;
}

.info-value {
  font-size: 24rpx;
  color: #2e7350;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-all;
}

.search-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #b9e0cc;
}

.error-icon {
  font-size: 24rpx;
}

.error-text {
  flex: 1;
  font-size: 22rpx;
  color: #d32f2f;
  line-height: 1.5;
}

.poi-card {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(84, 107, 96, 0.1);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.poi-card:first-of-type {
  border-top: 0;
}

.poi-name {
  font-size: 28rpx;
  color: #263238;
  font-weight: 800;
}

.poi-address,
.poi-phone {
  color: #6f8078;
  font-size: 24rpx;
  line-height: 1.4;
}

.resource-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fbfefd;
  border: 1rpx solid rgba(55, 133, 93, 0.12);
}

.resource-top {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.resource-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #263238;
}

.score-pill {
  width: 72rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #fff1d7;
  color: #95651c;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.meta-row,
.tag-row,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.meta-chip,
.tag-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef7f2;
  color: #2e7350;
  font-size: 22rpx;
}

.price {
  color: #a0671f;
  background: #fff3dd;
}

.resource-desc,
.resource-address {
  display: block;
  margin-top: 16rpx;
  color: #52665c;
  font-size: 25rpx;
  line-height: 1.55;
}

.resource-address {
  color: #75877d;
}

.action-row {
  margin-top: 20rpx;
}

.action-btn {
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f1f6f4;
  color: #52665c;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.primary {
  color: #ffffff;
  background: #28724e;
}

.bottom-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
