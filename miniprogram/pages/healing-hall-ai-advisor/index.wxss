/* healing-hall-ai-advisor/index.wxss */
/* 淡蓝色主题 - 专业、高效、理性 */

/* 页面背景 */
page {
  background: linear-gradient(180deg, #f4faff 0%, #e7f2fb 100%);
  height: 100%;
}

/* 容器 */
.advisor-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #E3F2FD 0%, #e2f1fd 100%);
}

/* ==================== 顶部导航 ==================== */
.advisor-header {
  flex-shrink: 0;
  background: linear-gradient(135deg, #90CAF9 0%, #a1d4fd 100%);
  padding-bottom: 24rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(66, 165, 245, 0.15);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

.header-back {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.advisor-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3e3d3d;
}

.advisor-subtitle {
  font-size: 25rpx;
  color: rgba(98, 97, 97, 0.9);
}

.header-right {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  font-size: 36rpx;
  opacity: 0.8;
}

/* ==================== 消息区域 ==================== */
.message-area {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 机器人消息 */
.bot-message {
  flex-direction: row;
  padding-right: 60rpx;
  justify-content: flex-start;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #42A5F5, #1E88E5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(66, 165, 245, 0.3);
}

.avatar-icon {
  font-size: 32rpx;
}

.message-bubble {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  word-wrap: break-word;
  word-break: break-all;
}

.bot-bubble {
  background-color: #FFFFFF;
  border-radius: 4rpx 28rpx 28rpx 28rpx;
  border: 2rpx solid rgba(66, 165, 245, 0.1);
  max-width: 70%;
}

.bot-bubble .message-text {
  display: block;
}

/* 用户消息 */
.user-message {
  flex-direction: row-reverse;
  padding-left: 0;
  padding-right: 45rpx;
  justify-content: flex-start;
}

.user-message .message-bubble {
  max-width: 75%;
  min-width: auto;
}

.user-bubble {
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 28rpx 4rpx 28rpx 28rpx;
  max-width: 100%;
  width: auto;
  flex-shrink: 0;
}

.message-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  word-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap;
}

.user-text {
  color: #FFFFFF;
  display: block;
  word-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap;
  width: 100%;
}

/* Rich-text 样式 */
.bot-bubble rich-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  width: 100%;
  display: block;
}

.message-bubble rich-text div {
  margin: 0;
  padding: 0;
}

.message-bubble rich-text br {
  display: block;
  margin: 4rpx 0;
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.recommendation-card {
  padding: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F6FBFF 0%, #EDF6FF 100%);
  border: 2rpx solid rgba(66, 165, 245, 0.14);
}

.recommendation-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.recommendation-title {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #165B97;
}

.recommendation-source {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(66, 165, 245, 0.12);
  color: #1E88E5;
  font-size: 22rpx;
  font-weight: 600;
}

.recommendation-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.meta-pill {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.meta-medium {
  color: #0E8A61;
  background: #E8F7F0;
}

.meta-district {
  color: #2563A9;
  background: #EAF4FF;
}

.meta-price {
  color: #F08A24;
  background: #FFF4E8;
  font-weight: 600;
}

.recommendation-address {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5F6B7A;
}

.recommendation-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #3D4B5A;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #D7EAFD;
  color: #5681A8;
  font-size: 22rpx;
}

.recommendation-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-btn {
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-btn text {
  font-size: 24rpx;
  font-weight: 600;
}

.detail-btn {
  background: linear-gradient(135deg, #42A5F5 0%, #1E88E5 100%);
  box-shadow: 0 8rpx 18rpx rgba(66, 165, 245, 0.2);
}

.detail-btn text {
  color: #FFFFFF;
}

.copy-btn {
  background: #EAF4FF;
}

.copy-btn text {
  color: #1E88E5;
}

.call-btn {
  background: #FFF4E8;
}

.call-btn text {
  color: #EF8A22;
}

/* 正在输入 */
.typing-bubble {
  padding: 20rpx 28rpx;
}

.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #42A5F5;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.scroll-bottom {
  height: 20rpx;
}

/* ==================== 快捷问题 ==================== */
.quick-questions-wrapper {
  flex-shrink: 0;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.quick-questions {
  white-space: nowrap;
}

.quick-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.quick-item {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E3F2FD;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #1976D2;
  transition: all 0.3s ease;
}

.quick-item:active {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-color: #42A5F5;
  transform: scale(0.98);
}

/* ==================== 输入区域 ==================== */
.input-area {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 2rpx solid #E3F2FD;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  background-color: #F5F5F5;
  border: 2rpx solid #E3F2FD;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #333333;
  transition: all 0.3s ease;
}

.message-input:focus {
  border-color: #42A5F5;
  background-color: #FFFFFF;
}

.input-placeholder {
  color: #BDBDBD;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #E3F2FD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.send-active {
  background: linear-gradient(135deg, #42A5F5 0%, #1E88E5 100%);
  box-shadow: 0 4rpx 16rpx rgba(66, 165, 245, 0.4);
}

.send-active:active {
  transform: scale(0.95);
}

.send-icon {
  font-size: 32rpx;
  color: #90CAF9;
  transform: rotate(45deg);
}

.send-active .send-icon {
  color: #FFFFFF;
}
