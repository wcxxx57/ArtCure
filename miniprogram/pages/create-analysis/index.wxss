page {
  background: #f8fbf8;
}

.create-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4fbf7 0%, #fff8ef 46%, #f7fbff 100%);
  color: #263238;
}

.create-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: calc(88rpx + env(safe-area-inset-top)) 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(248, 251, 248, 0.95);
  backdrop-filter: blur(18rpx);
  border-bottom: 1rpx solid rgba(74, 116, 96, 0.12);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #315d4b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(49, 93, 75, 0.12);
  flex-shrink: 0;
}

.header-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #20372e;
}

.header-subtitle {
  font-size: 22rpx;
  color: #697a72;
}

.create-scroll {
  box-sizing: border-box;
  height: 100vh;
  padding: calc(210rpx + env(safe-area-inset-top)) 24rpx 0;
}

.hero-panel,
.mode-switch,
.input-panel,
.note-panel,
.analysis-panel {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(74, 116, 96, 0.12);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(70, 91, 83, 0.07);
}

.hero-panel {
  padding: 30rpx;
}

.hero-kicker {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f5ef;
  color: #2f765d;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #20372e;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: #65736d;
  font-size: 26rpx;
  line-height: 1.6;
}

.mode-switch {
  margin-top: 24rpx;
  padding: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}

.mode-option {
  min-height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  color: #65736d;
}

.mode-active {
  background: #315d4b;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(49, 93, 75, 0.18);
}

.mode-label {
  font-size: 28rpx;
  font-weight: 800;
}

.mode-desc {
  font-size: 22rpx;
  opacity: 0.78;
}

.input-panel,
.note-panel,
.analysis-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.panel-hidden {
  display: none;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.panel-title,
.analysis-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #263238;
}

.panel-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #7b8983;
  font-size: 23rpx;
}

.clear-btn,
.change-image-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4f1;
  color: #4d6c60;
  font-size: 24rpx;
  flex-shrink: 0;
}

.healing-canvas {
  display: block;
  border-radius: 18rpx;
  border: 2rpx solid #d8e5df;
  background: #fffdf8;
  overflow: hidden;
}

.tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}

.color-list,
.size-list {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.color-dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.color-active {
  outline: 4rpx solid #263238;
}

.size-dot {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #eef4f1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-dot view {
  border-radius: 50%;
  background: #263238;
}

.size-active {
  background: #dceee7;
}

.upload-empty {
  height: 300rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #b9cec4;
  background: #fbfdfb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #315d4b;
}

.upload-desc,
.input-placeholder {
  font-size: 24rpx;
  color: #8a9892;
}

.image-preview {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.uploaded-image {
  width: 100%;
  height: 440rpx;
  border-radius: 18rpx;
  background: #f4f7f5;
}

.change-image-btn {
  align-self: center;
}

.note-input {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f6faf8;
  font-size: 26rpx;
  color: #263238;
  line-height: 1.5;
}

.prompt-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.prompt-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #edf6ff;
  color: #2d6687;
  font-size: 24rpx;
}

.analyze-btn {
  height: 92rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #315d4b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(49, 93, 75, 0.22);
}

.analyzing {
  background: #8aa99c;
}

.error-tip {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #fff4e7;
  color: #8a6427;
  font-size: 24rpx;
  line-height: 1.5;
}

.analysis-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.source-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4f1;
  color: #4d6c60;
  font-size: 22rpx;
}

.analysis-block {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f6faf8;
}

.block-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: #263238;
}

.block-text {
  display: block;
  color: #52645c;
  font-size: 26rpx;
  line-height: 1.75;
}

.safety-note {
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff8eb;
  color: #846329;
  font-size: 24rpx;
  line-height: 1.5;
}

.bottom-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
