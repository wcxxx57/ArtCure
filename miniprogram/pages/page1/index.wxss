/* index.wxss - 首页小屋 */
page {
  background-color: #FFFBF0;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #F0F8FF 50%, #FFFBF0 100%);
  padding-bottom: 180rpx;
}

/* ==================== 顶部问候区域 ==================== */
.header-section {
  padding: 40rpx 40rpx 30rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

.greeting-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.greeting-text {
  display: flex;
  flex-direction: column;
}

.greeting-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 2rpx;
}

.greeting-subtitle {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.header-avatar {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB7B2 0%, #FEE5E6 100%);
  padding: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 183, 178, 0.3);
  overflow: hidden;
  margin-top:40rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  background-color: #F5F5F5;
}

/* 未登录时的默认头像占位 */
.avatar-placeholder {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F8F8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
}

.avatar-icon {
  font-size: 44rpx;
  opacity: 0.8;
}

/* ==================== 虚拟形象区域 ==================== */
.avatar-section {
  position: relative;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
}

.avatar-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.6;
}

.blob-1 {
  width: 300rpx;
  height: 300rpx;
  background-color: #E3F2FD;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  animation: blob 7s infinite;
}

.blob-2 {
  width: 280rpx;
  height: 280rpx;
  background-color: #FEE5E6;
  left: 55%;
  top: 45%;
  transform: translate(-50%, -50%);
  animation: blob 7s infinite 2s;
}

@keyframes blob {
  0% { transform: translate(-50%, -50%) scale(1); }
  33% { transform: translate(-45%, -55%) scale(1.1); }
  66% { transform: translate(-55%, -45%) scale(0.9); }
  100% { transform: translate(-50%, -50%) scale(1); }
}

.virtual-avatar {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-character {
  width: 200rpx;
  height: 200rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.avatar-emoji {
  font-size: 100rpx;
}

.chat-hint {
  position: absolute;
  top: -20rpx;
  right: -60rpx;
  background-color: #FFFFFF;
  padding: 12rpx 24rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  animation: bounce 2s infinite;
}

.chat-hint text {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* ==================== 每日心情打卡 ==================== */
.mood-section {
  margin: 0 32rpx;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.mood-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.mood-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.mood-streak {
  font-size: 22rpx;
  color: #999999;
}

.mood-list {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  opacity: 0.6;
}

.mood-item:active {
  transform: scale(0.95);
}

.mood-selected {
  opacity: 1;
  transform: scale(1.1);
  background-color: rgba(255, 183, 178, 0.1);
}

.mood-emoji {
  font-size: 56rpx;
}

.mood-label {
  font-size: 22rpx;
  color: #666666;
}

/* ==================== 每日心理语录 ==================== */
.quote-section {
  margin: 24rpx 32rpx;
}

.quote-card {
  background: linear-gradient(135deg, #E3F2FD 0%, #F3E5F5 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.quote-icon {
  width: 64rpx;
  height: 64rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.15);
  flex-shrink: 0;
}

.quote-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quote-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #4A90E2;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.quote-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  font-style: italic;
  font-weight: 500;
}

/* ==================== 快捷功能 ==================== */
.quick-section {
  margin: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.quick-emoji {
  font-size: 44rpx;
}

.quick-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
}

/* ==================== 底部占位 ==================== */
.bottom-space {
  height: 40rpx;
}
