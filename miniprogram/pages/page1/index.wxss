/* index.wxss - 首页小屋 */
page {
  height: 100vh;
  overflow: hidden;
  background-color: #FFE4CF;
  color: #26323A;
}

.page-container {
  position: relative;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.bg-wrapper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.bg-image,
.bg-symbol,
.bg-soften {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
  display: block;
}

.bg-symbol {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.12;
}

.bg-soften {
  background: linear-gradient(180deg, rgba(255, 253, 247, 0.42) 0%, rgba(255, 246, 235, 0.2) 42%, rgba(255, 185, 177, 0.12) 100%);
}

.home-content {
  position: relative;
  z-index: 2;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: calc(50rpx + env(safe-area-inset-top)) 28rpx calc(112rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.header-section {
  flex-shrink: 0;
}

.greeting-area {
  height: 76rpx;
  padding-right: 186rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.greeting-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.greeting-title {
  font-size: 38rpx;
  line-height: 1.16;
  font-weight: 900;
  color: #203038;
  letter-spacing: 0;
}

.greeting-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.25;
  color: #785F5C;
}

.header-avatar {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  padding: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF9CAF 0%, #77D7CC 100%);
  box-shadow: 0 8rpx 18rpx rgba(204, 97, 113, 0.14);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  background-color: #FFFFFF;
  box-sizing: border-box;
}

.avatar-placeholder {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.avatar-icon {
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.78;
}

.hero-section {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
}

.hero-copy {
  position: relative;
  z-index: 3;
  width: 376rpx;
  padding-top: 24rpx;
}

.hero-kicker {
  display: inline-block;
  max-width: 330rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #1C817E;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 900;
  box-sizing: border-box;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #3a242f;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-subtitle {
  display: block;
  width: 356rpx;
  margin-top: 14rpx;
  color: #6E5552;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 500;
}

.ip-stage {
  position: absolute;
  right: -22rpx;
  bottom: 196rpx;
  width: 404rpx;
  height: 392rpx;
  z-index: 4;
}

.ip-symbol {
  position: absolute;
  display: block;
  pointer-events: none;
}

.ip-symbol-top {
  top: -78rpx;
  right: -76rpx;
  width: 468rpx;
  height: 468rpx;
  opacity: 0.72;
}

.ip-symbol-bottom {
  left: -12rpx;
  bottom: -36rpx;
  width: 392rpx;
  height: 392rpx;
  opacity: 0.34;
  transform: rotate(180deg);
}

.ip-image {
  position: absolute;
  right: 22rpx;
  bottom: 30rpx;
  width: 318rpx;
  height: 318rpx;
  display: block;
}

.ai-dialog {
  position: absolute;
  left: -272rpx;
  top: 88rpx;
  width: 344rpx;
  min-height: 112rpx;
  padding: 16rpx 18rpx 16rpx 20rpx;
  border-radius: 26rpx 26rpx 8rpx 26rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 12rpx 22rpx rgba(181, 96, 106, 0.12);
  box-sizing: border-box;
}

.ai-dialog-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.3;
  color: #24333A;
  font-weight: 900;
}

.ai-dialog-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 24rpx;
  line-height: 1.32;
  color: #7A625E;
  font-weight: 700;
}

.ai-dialog-tail {
  position: absolute;
  right: -13rpx;
  bottom: 22rpx;
  width: 26rpx;
  height: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  border-right: 2rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.78);
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.create-hero-card {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  z-index: 4;
  min-height: 178rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 252, 245, 0.82);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 36rpx rgba(201, 103, 117, 0.13);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.create-hero-card:active {
  transform: scale(0.992);
}

.create-hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
  box-sizing: border-box;
}

.create-entry-tag {
  display: inline-block;
  max-width: 328rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(112, 211, 202, 0.2);
  color: #1B7775;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.create-hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 38rpx;
  line-height: 1.16;
  color: #25333A;
  font-weight: 900;
}

.create-hero-subtitle {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: #695654;
  font-size: 22rpx;
  line-height: 1.34;
  font-weight: 500;
}

.create-hero-action {
  width: 144rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F36E88 0%, #F7A18A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 18rpx rgba(224, 90, 112, 0.18);
}

.create-hero-action text {
  color: #FFFFFF;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
}

.secondary-section {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  height: 326rpx;
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
}

.mood-section,
.quote-card {
  box-sizing: border-box;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 24rpx rgba(125, 76, 76, 0.07);
}

.mood-section {
  height: 178rpx;
  padding: 18rpx 18rpx 16rpx;
}

.mood-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.mood-title {
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #26323A;
}

.mood-streak {
  font-size: 21rpx;
  line-height: 1.2;
  color: #806B67;
}

.mood-list {
  display: flex;
  justify-content: space-between;
}

.mood-item {
  width: 118rpx;
  height: 98rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0.74;
  box-sizing: border-box;
}

.mood-item:active {
  transform: scale(0.96);
}

.mood-selected {
  opacity: 1;
  background: rgba(255, 151, 167, 0.18);
  box-shadow: 0 8rpx 16rpx rgba(215, 97, 115, 0.1);
}

.mood-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.mood-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #574F4B;
}

.quote-card {
  height: 134rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
}

.quote-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: rgba(112, 211, 202, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.quote-content {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.quote-tag {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #1B7775;
}

.quote-text {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 23rpx;
  line-height: 1.34;
  color: #3E4244;
  font-weight: 700;
}

@media screen and (max-height: 700px) {
  .home-content {
    padding-top: calc(42rpx + env(safe-area-inset-top));
    padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  }

  .greeting-area {
    height: 68rpx;
  }

  .hero-title {
    font-size: 43rpx;
  }

  .ip-stage {
    width: 354rpx;
    height: 344rpx;
    bottom: 178rpx;
  }

  .ip-symbol-top {
    width: 430rpx;
    height: 430rpx;
  }

  .ip-symbol-bottom {
    width: 354rpx;
    height: 354rpx;
  }

  .ip-image {
    width: 286rpx;
    height: 286rpx;
  }

  .ai-dialog {
    left: -232rpx;
    top: 140rpx;
    width: 314rpx;
    min-height: 104rpx;
    padding: 14rpx 16rpx 14rpx 18rpx;
  }

  .ai-dialog-title {
    font-size: 21rpx;
  }

  .ai-dialog-desc {
    font-size: 17rpx;
  }

  .create-hero-card {
    min-height: 164rpx;
    padding-top: 18rpx;
    padding-bottom: 18rpx;
  }

  .secondary-section {
    height: 304rpx;
  }

  .mood-section {
    height: 166rpx;
  }

  .mood-item {
    height: 88rpx;
  }

  .quote-card {
    height: 124rpx;
  }
}
