<!--index.wxml-->
<view class="page-container">
  <view class="bg-wrapper">
    <image class="bg-image" src="/images/index/bg.jpg" mode="aspectFill" fade-in="{{false}}"></image>
    <view class="bg-soften"></view>
  </view>
  
  <view class="home-content">

    <view class="hero-section">
      <view class="hero-copy">
        <text class="hero-title">你好呀，欢迎来到</text>
        <text class="hero-title">AI艺术疗愈小屋</text>
        <text class="hero-subtitle">让我们一起在艺术疗愈的体验与陪伴中，遇见更好的自己</text>
      </view>
      <view class="ip-stage" bindtap="onAvatarTap">
        <image class="ip-image" src="/images/index/ip.png" mode="aspectFit" fade-in="{{false}}"></image>
        <view class="ai-dialog">
          <text class="ai-dialog-title">今天怎么样？来和我说说吧！</text>
          <text class="ai-dialog-desc">点击和“艺呦”一起体验专业的陪伴式艺术疗愈指导</text>
          <view class="ai-dialog-tail"></view>
        </view>
      </view>
      <view class="create-hero-card" bindtap="onCreateAnalysisTap">
        <view class="create-hero-copy">
          <text class="create-entry-tag">{{createAnalysisEntry.tag}}</text>
          <text class="create-hero-title">{{createAnalysisEntry.title}}</text>
          <text class="create-hero-subtitle">{{createAnalysisEntry.subtitle}}</text>
        </view>
        <view class="create-hero-action">
          <text>开始创作</text>
        </view>
      </view>
    </view>

    <view class="secondary-section">
      <view class="mood-section">
        <view class="mood-header">
          <text class="mood-title">今日心情打卡</text>
          <text class="mood-streak">已连续 {{moodStreak}} 天</text>
        </view>
        <view class="mood-list">
          <view
            class="mood-item {{selectedMood === item.value ? 'mood-selected' : ''}}"
            wx:for="{{moodList}}"
            wx:key="value"
            bindtap="onMoodSelect"
            data-mood="{{item}}"
          >
            <text class="mood-emoji">{{item.emoji}}</text>
            <text class="mood-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="quote-card">
        <view class="quote-icon">🪶</view>
        <view class="quote-content">
          <text class="quote-tag">每日心理能量</text>
          <text class="quote-text">"{{dailyQuote}}"</text>
        </view>
      </view>
    </view>
  </view>
</view>
