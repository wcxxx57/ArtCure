.page-container {
  min-height: 100vh;
  background-color: #FFFBF0;
}

.page-header {
  display: flex;
  align-items: center;
  padding: 60rpx 32rpx 24rpx;
  background: linear-gradient(180deg, #fbaab4 0%, #FFFBF0 100%);
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
}

.header-title-wrap {
  flex: 1;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.header-placeholder {
  width: 64rpx;
}

.status-section {
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.status-text {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.result-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.error-section {
  padding: 24rpx 32rpx;
  background-color: #fff8f0;
  border-bottom: 1rpx solid #ffe4d4;
}

.error-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.error-text {
  font-size: 26rpx;
  color: #e06666;
}

.results-scroll {
  height: calc(100vh - 220rpx);
}

.results-list {
  padding: 24rpx;
}

.poi-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-title-wrap {
  flex: 1;
}

.poi-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.poi-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #fbaab4;
  background-color: #fff0f2;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.poi-distance {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.card-body {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.poi-address {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.address-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.address-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.poi-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.info-tag {
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.info-text {
  font-size: 26rpx;
  color: #999;
}

.card-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.footer-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 32rpx;
  flex: 1;
  justify-content: center;
}

.footer-btn:active {
  background-color: #e9ecef;
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 26rpx;
  color: #333;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 64rpx;
  background: linear-gradient(135deg, #fbaab4 0%, #f7909a 100%);
  border-radius: 48rpx;
}

.empty-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.bottom-space {
  height: 60rpx;
}
