/* user_login/index.wxss */
page {
  background: linear-gradient(180deg, #FFF5F7 0%, #F0F8FF 50%, #FFFBF0 100%);
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.content {
  width: 100%;
  max-width: 600rpx;
}

/* 头部区域 */
.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

/* 表单区域 */
.form {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.form-item {
  margin-bottom: 32rpx;
}

.input-wrapper {
  background-color: #F8F8F8;
  border-radius: 24rpx;
  padding: 0 30rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: #FFB7B2;
  background-color: #FFFFFF;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.password-wrapper {
  position: relative;
}

.eye-icon {
  width: 44rpx;
  height: 44rpx;
  margin-left: 20rpx;
  opacity: 0.5;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #4A90E2;
  margin-top: 12rpx;
  margin-left: 30rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 128, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn[disabled] {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  box-shadow: none;
}

.login-btn::after {
  border: none;
}

/* 底部链接 */
.footer-links {
  text-align: center;
  margin-top: 48rpx;
}

.link {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 500;
}
