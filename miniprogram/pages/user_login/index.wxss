/* user_login/index.wxss */
page {
  background: linear-gradient(135deg, #FFE5F0 0%, #FFF8DC 100%);
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.content {
  width: 100%;
  max-width: 600rpx;
}

/* 头部区域 */
.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666666;
}

/* 表单区域 */
.form {
  background-color: #FFFFFF;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(255, 182, 193, 0.2);
}

.form-item {
  margin-bottom: 40rpx;
}

.input-wrapper {
  background-color: #F5F5F5;
  border-radius: 20rpx;
  padding: 0 30rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.password-wrapper {
  position: relative;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #FFB6C1;
  margin-top: 10rpx;
  margin-left: 30rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FFB6C1;
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 20rpx;
}

.login-btn[disabled] {
  background-color: #FFCCD5;
}

.login-btn::after {
  border: none;
}

/* 底部链接 */
.footer-links {
  text-align: center;
  margin-top: 40rpx;
}

.link {
  font-size: 26rpx;
  color: #FFB6C1;
}
