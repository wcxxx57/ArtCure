page { background: #fdf5f1; }

.healing-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #4a3f4b;
  background: linear-gradient(180deg, #fbd9d0 0%, #fce9df 34%, #fff8f1 70%, #fffaf6 100%);
}

.ambient-glow { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(2rpx); }
.glow-one { width: 480rpx; height: 480rpx; top: 120rpx; right: -180rpx; background: rgba(255, 193, 192, .26); }
.glow-two { width: 430rpx; height: 430rpx; top: 620rpx; left: -220rpx; background: rgba(213, 191, 228, .19); }

.healing-header {
  position: fixed; z-index: 20; top: 0; left: 0; right: 0;
  padding: calc(64rpx + env(safe-area-inset-top)) 32rpx 20rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(253, 224, 214, .86); backdrop-filter: blur(22rpx);
}
.header-icon { width: 70rpx; height: 70rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #6e5964; background: rgba(255,255,255,.66); box-shadow: 0 8rpx 24rpx rgba(131, 87, 93, .08); }
.close-icon { font-size: 52rpx; font-weight: 200; line-height: 60rpx; }
.sound-icon { width: 86rpx; font-size: 21rpx; font-weight: 700; letter-spacing: 1rpx; }
.header-title-wrap { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; gap: 4rpx; }
.header-title { max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; font-weight: 800; color: #533f4c; letter-spacing: 1rpx; }
.header-subtitle { font-size: 21rpx; color: #9b7f85; }

.healing-scroll { box-sizing: border-box; height: 100vh; padding: calc(166rpx + env(safe-area-inset-top)) 34rpx 390rpx; }
.welcome-visual { position: relative; height: 386rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.healing-ip { position: relative; z-index: 3; width: 240rpx; height: 240rpx; filter: drop-shadow(0 20rpx 20rpx rgba(177, 116, 115, .20)); transition: transform .4s ease; }
.ip-speaking { animation: ipBreath 2.4s ease-in-out infinite; }
@keyframes ipBreath { 0%,100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-8rpx) scale(1.04); } }
.ip-orbit { position: absolute; border: 2rpx solid rgba(255,255,255,.66); border-radius: 50%; }
.orbit-back { width: 330rpx; height: 190rpx; transform: rotate(-18deg); }
.orbit-front { width: 390rpx; height: 230rpx; transform: rotate(20deg); border-color: rgba(220, 174, 181, .38); }
.ip-caption { position: absolute; z-index: 4; bottom: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.caption-title { color: #684f5b; font-size: 29rpx; font-weight: 700; }
.caption-subtitle { color: #a18189; font-size: 22rpx; }

.intro-card { padding: 32rpx 30rpx 28rpx; border-radius: 30rpx; background: rgba(255,255,255,.60); border: 1rpx solid rgba(255,255,255,.84); box-shadow: 0 16rpx 40rpx rgba(170, 111, 113, .10); }
.intro-kicker { color: #c69098; font-size: 18rpx; letter-spacing: 4rpx; font-weight: 700; }
.intro-title { display: block; margin-top: 16rpx; color: #594351; font-size: 40rpx; font-weight: 800; }
.intro-copy { display: block; margin-top: 18rpx; color: #816d75; font-size: 25rpx; line-height: 1.7; }
.intro-notice { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 22rpx; color: #a48b91; font-size: 20rpx; line-height: 1.5; }
.notice-dot { color: #e49aa3; font-size: 32rpx; line-height: 20rpx; }
.voice-picker { display: block; margin-top: 24rpx; }
.voice-picker-inner { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 22rpx; border-radius: 20rpx; background: rgba(255,255,255,.72); border: 1rpx solid rgba(220, 183, 190, .34); }
.voice-picker-copy { display: flex; flex-direction: column; gap: 5rpx; }
.voice-picker-label { color: #967780; font-size: 20rpx; }
.voice-picker-value { color: #634d5a; font-size: 27rpx; font-weight: 700; }
.voice-picker-action { color: #c38391; font-size: 21rpx; }

.session-summary { display: flex; gap: 12rpx; overflow: hidden; margin-bottom: 22rpx; }
.summary-pill { flex-shrink: 0; padding: 10rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.62); color: #9a727d; font-size: 21rpx; }
.summary-soft { color: #8a7a96; background: rgba(238, 226, 241, .62); }
.message-list { margin-top: 26rpx; }
.message-row { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 24rpx; }
.message-user { justify-content: flex-end; }
.message-avatar { flex: 0 0 auto; width: 62rpx; height: 62rpx; margin-top: 30rpx; border-radius: 50%; background: rgba(255,255,255,.62); }
.message-content { max-width: 78%; }
.message-user .message-content { display: flex; flex-direction: column; align-items: flex-end; }
.message-label { margin: 0 12rpx 8rpx; color: #b18c95; font-size: 19rpx; }
.voice-mark { color: #d6929b; }
.message-bubble { padding: 20rpx 23rpx; border-radius: 24rpx; color: #5b4a55; background: rgba(255,255,255,.86); border: 1rpx solid rgba(255,255,255,.9); box-shadow: 0 10rpx 28rpx rgba(171, 111, 116, .08); font-size: 26rpx; line-height: 1.65; white-space: pre-wrap; }
.message-user .message-bubble { color: #fffaf8; background: #d9989d; border-bottom-right-radius: 8rpx; }
.message-assistant .message-bubble { border-bottom-left-radius: 8rpx; }
.thinking-bubble { padding: 24rpx 30rpx; }
.thinking-dots { display: flex; gap: 8rpx; align-items: center; }
.thinking-dots text { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d79ca4; animation: dotJump 1s ease-in-out infinite; }
.thinking-dots text:nth-child(2) { animation-delay: .15s; }.thinking-dots text:nth-child(3) { animation-delay: .3s; }
@keyframes dotJump { 0%,100% { transform: translateY(0); opacity: .45; } 50% { transform: translateY(-8rpx); opacity: 1; } }

.tool-trace { margin: 12rpx 8rpx 28rpx; padding: 20rpx; border-radius: 22rpx; background: rgba(244, 234, 244, .64); border: 1rpx solid rgba(215, 188, 218, .38); }
.trace-title { display: flex; align-items: center; gap: 10rpx; color: #927a9c; font-size: 21rpx; }
.trace-line { width: 8rpx; height: 8rpx; border-radius: 50%; background: #cf9eae; }
.tool-event { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(205, 179, 211, .24); }
.tool-icon { width: 50rpx; height: 50rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #af8096; background: rgba(255,255,255,.65); font-size: 28rpx; }
.tool-copy { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.tool-name { color: #6e536d; font-size: 23rpx; font-weight: 700; }.tool-desc { color: #a38d9e; font-size: 19rpx; }.tool-state { color: #b7909f; font-size: 19rpx; }.tool-done .tool-state { color: #8aaf9c; }
.scroll-bottom { height: 4rpx; }

.healing-footer { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; padding: 18rpx 34rpx calc(24rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; background: linear-gradient(180deg, rgba(255,249,245,0) 0%, rgba(255,249,245,.90) 20%, #fff9f5 52%); }
.footer-session { background: linear-gradient(180deg, rgba(255,249,245,0) 0%, rgba(255,249,245,.94) 20%, #fff9f5 52%); }
.footer-status { display: flex; align-items: center; gap: 12rpx; min-height: 42rpx; color: #9d7d86; font-size: 21rpx; }
.status-wave { display: flex; align-items: center; gap: 4rpx; height: 26rpx; }.status-wave text { width: 4rpx; height: 10rpx; border-radius: 4rpx; background: #d6a3aa; }.wave-listening text { animation: wave 1s ease-in-out infinite; }.wave-listening text:nth-child(2) { animation-delay: .12s; }.wave-listening text:nth-child(3) { animation-delay: .24s; }.wave-listening text:nth-child(4) { animation-delay: .36s; }.wave-listening text:nth-child(5) { animation-delay: .48s; }
@keyframes wave { 0%,100% { height: 8rpx; } 50% { height: 24rpx; } }
.main-control { position: relative; width: 158rpx; height: 158rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: center; }
.control-core { position: relative; z-index: 3; width: 120rpx; height: 120rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; background: linear-gradient(135deg, #efb3b1, #d98f9d); box-shadow: 0 14rpx 26rpx rgba(208, 133, 144, .25); font-size: 27rpx; font-weight: 700; line-height: 1.35; }
.control-start .control-core { background: linear-gradient(135deg, #efaaa8, #d78b9c); }.control-stop .control-core { background: linear-gradient(135deg, #dba4b2, #b48da8); }.control-listening .control-core { background: linear-gradient(135deg, #d394a8, #9f89ad); }
.control-ripple { position: absolute; z-index: 1; width: 144rpx; height: 144rpx; border-radius: 50%; border: 1rpx solid rgba(221, 158, 169, .45); }.ripple-two { width: 158rpx; height: 158rpx; border-color: rgba(221, 158, 169, .20); }.control-start .control-ripple { animation: ripple 2.2s ease-in-out infinite; }.control-start .ripple-two { animation-delay: .6s; }
@keyframes ripple { 0%,100% { transform: scale(.94); opacity: .7; } 50% { transform: scale(1.08); opacity: .2; } }
.footer-tip { margin-top: 2rpx; color: #b39ba1; font-size: 19rpx; }
