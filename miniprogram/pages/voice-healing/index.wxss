page {
  background: #f7fbff;
}

.voice-page {
  min-height: 100vh;
  color: #263238;
  background: linear-gradient(180deg, #edf8ff 0%, #fffaf4 58%, #ffffff 100%);
}

.voice-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: calc(88rpx + env(safe-area-inset-top)) 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(247, 251, 255, 0.94);
  backdrop-filter: blur(18rpx);
  border-bottom: 1rpx solid rgba(86, 143, 180, 0.12);
}

.back-btn,
.play-guide {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #286a8f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(50, 102, 134, 0.12);
  flex-shrink: 0;
}

.play-guide {
  font-size: 26rpx;
}

.header-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #203744;
}

.header-subtitle {
  font-size: 22rpx;
  color: #6f8794;
}

.voice-scroll {
  box-sizing: border-box;
  height: 100vh;
  padding: calc(218rpx + env(safe-area-inset-top)) 28rpx 164rpx;
}

.hero-panel,
.record-panel,
.quick-panel {
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(77, 135, 169, 0.14);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(41, 93, 122, 0.08);
}

.hero-panel {
  padding: 30rpx;
}

.hero-label {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e2f3ff;
  color: #27739b;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.hero-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #182f3c;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  color: #536b78;
  font-size: 26rpx;
  line-height: 1.6;
}

.mood-row {
  display: flex;
  gap: 14rpx;
  margin-top: 26rpx;
  flex-wrap: wrap;
}

.mood-chip,
.prompt-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f2f6f8;
  color: #536b78;
}

.mood-active {
  color: #ffffff;
  background: #2e83ad;
  font-weight: 700;
}

.record-panel {
  margin-top: 24rpx;
  padding: 34rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-button {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  background: #dff2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(46, 131, 173, 0.18);
}

.record-core {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2e83ad;
}

.recording {
  background: #ffe5e0;
  animation: recordingPulse 1.2s ease-in-out infinite;
}

.recording .record-core {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: #e15f4f;
}

@keyframes recordingPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

.record-status {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #203744;
}

.record-tip {
  margin-top: 10rpx;
  color: #78909c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.quick-panel {
  margin-top: 24rpx;
  padding: 20rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.prompt-chip {
  background: #fff7e8;
  color: #8b6426;
}

.message-list {
  margin-top: 26rpx;
}

.message-row {
  display: flex;
  margin-bottom: 18rpx;
}

.message-user {
  justify-content: flex-end;
}

.message-bot {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 78%;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.message-user .message-bubble {
  color: #ffffff;
  background: #2e83ad;
  border-bottom-right-radius: 8rpx;
}

.message-bot .message-bubble {
  color: #263238;
  background: #ffffff;
  border: 1rpx solid rgba(77, 135, 169, 0.14);
  border-bottom-left-radius: 8rpx;
}

.thinking {
  color: #78909c;
}

.input-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(86, 143, 180, 0.12);
}

.text-input {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  background: #f1f6f9;
  padding: 0 26rpx;
  color: #263238;
  font-size: 26rpx;
}

.input-placeholder {
  color: #9aaeb8;
}

.send-btn {
  height: 76rpx;
  min-width: 112rpx;
  border-radius: 999rpx;
  background: #dbe7ed;
  color: #7b929d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.send-active {
  color: #ffffff;
  background: #2e83ad;
}

.bottom-space {
  height: 30rpx;
}
