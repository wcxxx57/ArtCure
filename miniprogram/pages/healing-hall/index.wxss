/* healing-hall/index.wxss */
page {
  background: linear-gradient(180deg, #FFF5F0 0%, #FFE8E0 100%);
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFE8E0 100%);
  padding-bottom: 180rpx;
}

/* ==================== 页面头部 ==================== */
.page-header {
  padding: 40rpx 40rpx 12rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A3535;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

/* ==================== 搜索栏 ==================== */
.search-section {
  padding: 16rpx 32rpx 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F0F0F0;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #CCCCCC;
}

.search-clear {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx 16rpx;
}

/* ==================== POI附近疗愈探索 ==================== */
.poi-discovery-section {
  padding: 0 32rpx 18rpx;
}

.poi-discovery-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(255, 154, 139, 0.16);
}

.poi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.poi-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  color: #4A3535;
}

.poi-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.poi-location-btn {
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #E8F8F5;
  color: #2D7D68;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.poi-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.poi-city-input,
.poi-keyword-input {
  height: 70rpx;
  border-radius: 18rpx;
  background: #F8F8F8;
  color: #333333;
  font-size: 25rpx;
  padding: 0 18rpx;
}

.poi-city-input {
  width: 150rpx;
  flex-shrink: 0;
}

.poi-keyword-input {
  flex: 1;
}

.poi-search-btn {
  width: 72rpx;
  height: 70rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.poi-chip-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.poi-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #FFF5F0;
  color: #E07B5F;
  font-size: 22rpx;
}

.poi-chip-active {
  color: #FFFFFF;
  background: #E07B5F;
}

.poi-status {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #777777;
}

.poi-info-section {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FFF9F8;
  border: 1rpx solid #FFD0C5;
}

.poi-search-params {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.poi-info-label {
  font-size: 22rpx;
  color: #999;
}

.poi-info-value {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.poi-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #FFD0C5;
}

.poi-error-icon {
  font-size: 24rpx;
}

.poi-error-text {
  flex: 1;
  font-size: 22rpx;
  color: #FF6B6B;
  line-height: 1.5;
}

.poi-debug-section {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  border: 1rpx dashed #ccc;
}

.debug-header {
  margin-bottom: 10rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #eee;
}

.debug-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #666;
}

.debug-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.debug-item {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.debug-label {
  font-size: 20rpx;
  color: #999;
  flex-shrink: 0;
}

.debug-value {
  font-size: 20rpx;
  color: #333;
  word-break: break-all;
}

.debug-value.small {
  font-size: 18rpx;
  color: #666;
}

.debug-value.error {
  color: #FF6B6B;
}

.poi-result-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.poi-result-card {
  width: 230rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F9FBFC;
  flex-shrink: 0;
}

.poi-result-name {
  display: block;
  color: #333333;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-result-address {
  display: block;
  margin-top: 6rpx;
  color: #999999;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 分类标签 ==================== */
.category-scroll {
  padding: 0 32rpx 16rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #666666;
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.category-icon {
  font-size: 24rpx;
}

.category-active {
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 139, 0.35);
}

/* ==================== 筛选栏 ==================== */
.filter-bar {
  display: flex;
  padding: 0 32rpx 12rpx;
  gap: 0;
}

.filter-bar-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #666;
  position: relative;
}

.filter-bar-item text:first-child {
  font-weight: 500;
}

.filter-arrow {
  font-size: 18rpx;
  color: #999;
}

.filter-bar-active text {
  color: #FF6B6B !important;
}

.filter-bar-selected text:first-child {
  color: #FF6B6B;
  font-weight: 600;
}

/* ==================== 筛选下拉面板 ==================== */
.filter-panel-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.filter-panel {
  position: absolute;
  top: calc(380rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 0 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 101;
  animation: slideDown 0.2s ease-out;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s ease;
}

.filter-option-active {
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFFFFF;
  font-weight: 600;
}

/* ==================== 活跃筛选标签 ==================== */
.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx 16rpx;
  align-items: center;
}

.active-filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #FFF0EB;
  font-size: 22rpx;
  color: #FF6B6B;
  border: 1rpx solid #FFD0C5;
}

.tag-remove {
  font-size: 20rpx;
  color: #FF9A8B;
  margin-left: 2rpx;
}

.clear-all-btn {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #999;
}

/* ==================== AI资源顾问 ==================== */
.ai-advisor-section {
  padding: 0 32rpx 20rpx;
}

.ai-advisor-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.3);
}

/* ==================== 内容类型切换 ==================== */
.content-type-tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #FFF;
  font-size: 28rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.type-tab-active {
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFF;
  font-weight: 600;
}

.ai-advisor-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-advisor-content {
  flex: 1;
}

.ai-advisor-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.ai-advisor-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
}

.ai-advisor-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 12rpx;
}

/* ==================== 结果统计 ==================== */
.result-header {
  padding: 0 32rpx 12rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
}

/* ==================== 加载/空状态 ==================== */
.loading-container, .empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text { font-size: 28rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 8rpx; }
.empty-hint { font-size: 24rpx; color: #CCC; margin-bottom: 24rpx; }

.empty-action {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFF;
  font-size: 26rpx;
  font-weight: 500;
}

/* ==================== 资源卡片 - 大众点评风格 ==================== */
.shops-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.shop-card {
  position: relative;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s ease;
}

.shop-card:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.1);
}

/* 封面区域 */
.shop-cover-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.shop-cover-img {
  width: 100%;
  height: 100%;
}

.shop-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-cover-emoji {
  font-size: 96rpx;
}

/* 独家合作角标 */
.exclusive-badge {
  position: absolute;
  top: 16rpx;
  left: 0;
  background: linear-gradient(135deg, #FF6B6B 0%, #ee5a24 100%);
  color: #FFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx 8rpx 16rpx;
  border-radius: 0 20rpx 20rpx 0;
  z-index: 2;
}

/* 评分角标 */
.rating-badge {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(10rpx);
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star-icon {
  font-size: 22rpx;
  color: #FFD700;
}

.rating-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 信息区域 */
.shop-info {
  padding: 20rpx 24rpx 24rpx;
}

.shop-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标签行 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
  align-items: center;
}

.format-tag {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: #EEF2FF;
  color: #5B6ABF;
}

/* 等级徽章 */
.level-badge {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.level-certified {
  background: #E8F5E9;
  color: #2E7D32;
}

.level-experienced {
  background: #FFF3E0;
  color: #E65100;
}

.level-emerging {
  background: #E3F2FD;
  color: #1565C0;
}

/* 价格 + 来源行 */
.price-source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.price-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.source-tags {
  display: flex;
  gap: 8rpx;
}

.source-tag {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #888;
  background: #F5F5F5;
}

/* 地址 */
.shop-address {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 10rpx;
}

.address-icon { font-size: 22rpx; }

.address-text {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance-text {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #E8F8F5;
  color: #2D7D68;
  font-size: 20rpx;
}

/* 特色标签 */
.feature-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.feature-chip {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #E07B5F;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8E0 100%);
}

/* ==================== 底部 ==================== */
.bottom-space {
  height: 40rpx;
}

/* ==================== 活动列表 ==================== */
.activities-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card-item {
  background: #FFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.activity-cover {
  width: 100%;
  height: 320rpx;
}

.activity-info {
  padding: 24rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.activity-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.activity-book-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFF;
  font-size: 26rpx;
}
