/* healing-hall/index.wxss - 疗愈馆 */
page {
  background-color: #FDFBF7;
}

.page-container {
  min-height: 100vh;
  background-color: #FDFBF7;
  padding-bottom: 180rpx;
}

/* ==================== 页面头部 ==================== */
.page-header {
  padding: 40rpx 40rpx 20rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
}

/* ==================== 搜索栏 ==================== */
.search-section {
  padding: 0 32rpx 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F0F0F0;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #CCCCCC;
}

/* ==================== 分类标签 ==================== */
.category-scroll {
  padding: 0 32rpx 24rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #999999;
  background-color: #FFFFFF;
  border: 2rpx solid #F0F0F0;
  transition: all 0.3s ease;
}

.category-active {
  background-color: #4A90E2;
  color: #FFFFFF;
  border-color: #4A90E2;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

/* ==================== 精选视频 ==================== */
.featured-section {
  padding: 0 32rpx 32rpx;
}

.featured-card {
  position: relative;
  height: 320rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.featured-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 60%);
}

.featured-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.play-icon {
  font-size: 28rpx;
  color: #FF8A80;
  margin-left: 4rpx;
}

.featured-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
}

.featured-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.featured-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ==================== 资源列表 ==================== */
.resources-section {
  padding: 0 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.resources-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.resource-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F8F8F8;
  transition: all 0.3s ease;
}

.resource-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.resource-cover {
  height: 200rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 16rpx;
}

.resource-emoji {
  font-size: 64rpx;
}

.resource-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10rpx);
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
}

.resource-badge text {
  font-size: 20rpx;
  color: #666666;
  font-weight: 500;
}

.resource-info {
  padding: 0 8rpx;
}

.resource-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.resource-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.resource-views {
  font-size: 22rpx;
  color: #999999;
}

.resource-like {
  width: 48rpx;
  height: 48rpx;
  background-color: #F8F8F8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.like-icon {
  font-size: 24rpx;
  color: #999999;
}

/* ==================== 线下沙龙 ==================== */
.salon-section {
  padding: 32rpx;
}

.salon-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.salon-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F8F8F8;
}

.salon-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.salon-location {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.location-icon {
  font-size: 24rpx;
}

.salon-location text:last-child {
  font-size: 22rpx;
  color: #999999;
}

.salon-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.salon-time {
  font-size: 24rpx;
  color: #666666;
}

.salon-seats {
  background-color: #FEE5E6;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.seats-text {
  font-size: 24rpx;
  color: #FF8A80;
  font-weight: 500;
}

/* ==================== 底部占位 ==================== */
.bottom-space {
  height: 40rpx;
}
