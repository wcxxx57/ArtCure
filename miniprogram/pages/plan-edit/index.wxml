<!--plan-edit/index.wxml-->
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="navbar-back" bindtap="onBack">
      <text class="back-text">←</text>
    </view>
    <text class="navbar-title">编辑计划</text>
  </view>

  <!-- 基本信息 -->
  <view class="section">
    <text class="section-title">基本信息</text>
    <view class="info-card">
      <view class="form-item">
        <text class="form-label">计划名称</text>
        <input 
          class="form-input" 
          value="{{planInfo.name}}"
          bindinput="onNameInput"
          placeholder="请输入计划名称"
          maxlength="20"
        />
      </view>
      
      <view class="form-item">
        <text class="form-label">计划图标</text>
        <view class="emoji-picker">
          <view 
            class="emoji-item {{item === planInfo.emoji ? 'selected' : ''}}"
            wx:for="{{emojiList}}"
            wx:key="*this"
            bindtap="onEmojiSelect"
            data-emoji="{{item}}"
          >
            <text class="emoji-text">{{item}}</text>
          </view>
        </view>
      </view>
      
      <view class="form-item">
        <text class="form-label">背景颜色</text>
        <view class="color-picker">
          <view 
            class="color-item {{item === planInfo.bgColor ? 'selected' : ''}}"
            wx:for="{{colorList}}"
            wx:key="*this"
            style="background-color: {{item}}"
            bindtap="onColorSelect"
            data-color="{{item}}"
          >
            <text class="check-icon" wx:if="{{item === planInfo.bgColor}}">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">任务列表</text>
      <text class="task-count">共{{tasks.length}}天</text>
    </view>
    
    <view class="tasks-list">
      <view 
        class="task-card"
        wx:for="{{tasks}}"
        wx:key="day"
      >
        <view class="task-header">
          <view class="task-day">第{{item.day}}天</view>
          <view class="task-actions">
            <text class="action-btn edit" bindtap="onEditTask" data-index="{{index}}">编辑</text>
            <text class="action-btn delete" bindtap="onDeleteTask" data-index="{{index}}">删除</text>
          </view>
        </view>
        <view class="task-content">
          <text class="task-title">{{item.title}}</text>
          <view class="task-meta">
            <text class="task-type">{{item.typeIcon}} {{item.typeName}}</text>
            <text class="task-duration">{{item.duration}}分钟</text>
          </view>
        </view>
      </view>
    </view>
    
    <button class="add-task-btn" bindtap="onAddTask">
      <text class="add-icon">+</text>
      <text>添加任务</text>
    </button>
  </view>

  <!-- 提醒设置 -->
  <view class="section">
    <text class="section-title">提醒设置</text>
    <view class="info-card">
      <view class="form-item row">
        <text class="form-label">每日提醒</text>
        <switch 
          checked="{{reminderEnabled}}"
          bindchange="onReminderToggle"
          color="#FFB6C1"
        />
      </view>
      
      <view class="form-item" wx:if="{{reminderEnabled}}">
        <text class="form-label">提醒时间</text>
        <picker 
          mode="time" 
          value="{{reminderTime}}"
          bindchange="onTimeChange"
        >
          <view class="picker-value">{{reminderTime || '请选择时间'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn" bindtap="onCancel">取消</button>
    <button class="action-btn save-btn" bindtap="onSave">保存修改</button>
  </view>
</view>

<!-- 编辑任务弹窗 -->
<view class="modal-mask" wx:if="{{showTaskModal}}" bindtap="onCloseTaskModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{editingIndex === -1 ? '添加任务' : '编辑任务'}}</text>
      <text class="modal-close" bindtap="onCloseTaskModal">✕</text>
    </view>
    
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">任务标题</text>
        <input 
          class="form-input" 
          value="{{editingTask.title}}"
          bindinput="onTaskTitleInput"
          placeholder="请输入任务标题"
        />
      </view>
      
      <view class="form-item">
        <text class="form-label">任务类型</text>
        <input 
          class="form-input" 
          value="{{editingTask.typeName}}"
          bindinput="onTaskTypeInput"
          placeholder="如：冥想、绘画、书写"
        />
      </view>
      
      <view class="form-item">
        <text class="form-label">类型图标</text>
        <view class="emoji-picker small">
          <view 
            class="emoji-item {{item === editingTask.typeIcon ? 'selected' : ''}}"
            wx:for="{{taskIconList}}"
            wx:key="*this"
            bindtap="onTaskIconSelect"
            data-icon="{{item}}"
          >
            <text class="emoji-text">{{item}}</text>
          </view>
        </view>
      </view>
      
      <view class="form-item">
        <text class="form-label">预计时长（分钟）</text>
        <input 
          class="form-input" 
          type="number"
          value="{{editingTask.duration}}"
          bindinput="onTaskDurationInput"
          placeholder="请输入时长"
        />
      </view>
      
      <view class="form-item">
        <text class="form-label">任务描述</text>
        <textarea 
          class="form-textarea" 
          value="{{editingTask.description}}"
          bindinput="onTaskDescInput"
          placeholder="请输入任务描述"
          maxlength="200"
        />
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="modal-btn cancel-btn" bindtap="onCloseTaskModal">取消</button>
      <button class="modal-btn confirm-btn" bindtap="onConfirmTask">确认</button>
    </view>
  </view>
</view>
