/* activity-feedback/index.wxss */
page {
  background: linear-gradient(180deg, #FFF5F0 0%, #FFE8E0 100%);
  min-height: 100vh;
}

.page-header {
  padding: 40rpx 40rpx 24rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
}

.header-back {
  font-size: 48rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A3535;
}

.feedback-card {
  margin: 24rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 32rpx;
}

.rating-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.stars {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 48rpx;
}

.feedback-input {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 200rpx;
}

.submit-btn {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
