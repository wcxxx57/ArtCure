/* AI 对话页面样式 index.wxss */
page {
  background: linear-gradient(180deg, #FFF5F0 0%, #FFE8E0 100%);
  height: 100%;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFE8E0 100%);
}

/* ==================== 顶部导航 ==================== */
.chat-header {
  flex-shrink: 0;
  background: linear-gradient(135deg, #FFD6C8 0%, #FFCABC 100%);
  padding-bottom: 24rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 154, 139, 0.15);
}

/* 顶部栏 */
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

/* 左侧返回按钮 */
.header-back {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.back-avatar {
  width: 72rpx;
  height: 72rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  overflow: hidden;
}

.back-logo {
  width: 60rpx;
  height: 60rpx;
}

.back-emoji {
  font-size: 36rpx;
}

.header-back:active .back-avatar {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 中间标题 */
.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bot-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.bot-status {
  font-size: 25rpx;
  color: #666666;
}

/* 右侧占位 */
.header-right {
  width: 88rpx;
}

/* ==================== 模式选择器 ==================== */
.mode-selector {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 8rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.mode-item:active {
  transform: scale(0.98);
}

.mode-active {
  background: linear-gradient(135deg, #FFC5C1 0%, #FFB5B0 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(255, 197, 193, 0.3);
}

.mode-icon {
  font-size: 28rpx;
}

.mode-name {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.mode-active .mode-name {
  color: #FFFFFF;
}

/* ==================== 消息区域 ==================== */
.message-area {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 机器人消息 */
.bot-message {
  flex-direction: row;
  padding-right: 60rpx;
  justify-content: flex-start;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.avatar-logo {
  width: 62rpx;
  height: 62rpx;
}

.avatar-emoji {
  font-size: 30rpx;
}

.message-bubble {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  word-wrap: break-word;
  word-break: break-all;
}

.bot-bubble {
  background-color: #FFFFFF;
  border-radius: 4rpx 28rpx 28rpx 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.03);
  max-width: 70%; /* 只对机器人消息限制最大宽度 */
}

/* 用户消息 */
.user-message {
  flex-direction: row-reverse;
  padding-left: 0; /* 完全移除左侧padding */
  padding-right: 45rpx; /* 给右侧适当的padding */
  justify-content: flex-start; /* 确保从右侧开始布局 */
}

.user-message .message-bubble {
  max-width: 75%; /* 设置合理的最大宽度 */
  min-width: auto; /* 允许根据内容自适应 */
}

.user-bubble {
  background: linear-gradient(135deg, #f7cdc9ff 0%, #fde1d6ff 100%);
  border-radius: 28rpx 4rpx 28rpx 28rpx;
  max-width: 100%; /* 在容器内完全展示 */
  width: auto; /* 自适应宽度 */
  flex-shrink: 0; /* 防止被压缩 */
}

.user-bubble .message-text,
.user-bubble .user-text {
  color: #151515ff;
}

.message-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  word-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap; /* 保留换行和空格 */
}

.user-text {
  display: block;
  word-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap; /* 保留换行和空格 */
  width: 100%; /* 确保完整显示 */
}

/* Rich-text 样式 */
.bot-bubble rich-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  width: 100%;
  display: block;
}

/* Rich-text 内部样式优化 */
.message-bubble rich-text div {
  margin: 0;
  padding: 0;
}

.message-bubble rich-text br {
  display: block;
  margin: 4rpx 0;
}

/* 正在输入指示器 */
.typing-bubble {
  padding: 20rpx 28rpx;
}

.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #CCCCCC;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.scroll-bottom {
  height: 20rpx;
}

/* ==================== 快捷问题 ==================== */
.quick-questions-wrapper {
  flex-shrink: 0;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.quick-questions {
  white-space: nowrap;
}

.quick-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.quick-item {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.quick-item:active {
  background-color: #E3F2FD;
  border-color: #FFC5C1;
  color: #4A90E2;
}

/* ==================== 输入区域 ==================== */
.input-area {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 2rpx solid #F5F5F5;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  background-color: #F8F8F8;
  border: 2rpx solid #EEEEEE;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #333333;
  transition: all 0.3s ease;
}

.message-input:focus {
  border-color: #FFC5C1;
  background-color: #FFFFFF;
}

.input-placeholder {
  color: #CCCCCC;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #EEEEEE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.send-active {
  background: linear-gradient(135deg, #FFC5C1 0%, #FFB5B0 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 197, 193, 0.4);
}

.send-active:active {
  transform: scale(0.95);
}

.send-icon {
  font-size: 32rpx;
  color: #999999;
  transform: rotate(45deg);
}

.send-active .send-icon {
  color: #FFFFFF;
}
