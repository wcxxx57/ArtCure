/* AI 对话页面样式 index.wxss */
page {
  background-color: #FFFBF0;
  height: 100%;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FFFBF0;
}

/* ==================== 顶部导航 ==================== */
.chat-header {
  flex-shrink: 0;
  background: linear-gradient(135deg, #E3F2FD 0%, #F3E5F5 100%);
  padding-bottom: 24rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 226, 0.1);
}

/* 顶部栏 */
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(140rpx + env(safe-area-inset-top));
}

/* 左侧返回按钮 */
.header-back {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.back-avatar {
  width: 72rpx;
  height: 72rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.back-emoji {
  font-size: 36rpx;
}

.header-back:active .back-avatar {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 中间标题 */
.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bot-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.bot-status {
  font-size: 25rpx;
  color: #666666;
}

/* 右侧占位 */
.header-right {
  width: 88rpx;
}

/* ==================== 模式选择器 ==================== */
.mode-selector {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 8rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.mode-item:active {
  transform: scale(0.98);
}

.mode-active {
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(255, 138, 128, 0.3);
}

.mode-icon {
  font-size: 28rpx;
}

.mode-name {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.mode-active .mode-name {
  color: #FFFFFF;
}

/* ==================== 消息区域 ==================== */
.message-area {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

/* 机器人消息 */
.bot-message {
  flex-direction: row;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.avatar-emoji {
  font-size: 30rpx;
}

.message-bubble {
  max-width: 75%;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.bot-bubble {
  background-color: #FFFFFF;
  border-radius: 4rpx 28rpx 28rpx 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.03);
}

/* 用户消息 */
.user-message {
  flex-direction: row-reverse;
}

.user-bubble {
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  border-radius: 28rpx 4rpx 28rpx 28rpx;
}

.user-bubble .message-text {
  color: #FFFFFF;
}

.message-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 正在输入指示器 */
.typing-bubble {
  padding: 20rpx 28rpx;
}

.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #CCCCCC;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.scroll-bottom {
  height: 20rpx;
}

/* ==================== 快捷问题 ==================== */
.quick-questions-wrapper {
  flex-shrink: 0;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.quick-questions {
  white-space: nowrap;
}

.quick-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.quick-item {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.quick-item:active {
  background-color: #E3F2FD;
  border-color: #4A90E2;
  color: #4A90E2;
}

/* ==================== 输入区域 ==================== */
.input-area {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 2rpx solid #F5F5F5;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  background-color: #F8F8F8;
  border: 2rpx solid #EEEEEE;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #333333;
  transition: all 0.3s ease;
}

.message-input:focus {
  border-color: #FFB7B2;
  background-color: #FFFFFF;
}

.input-placeholder {
  color: #CCCCCC;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #EEEEEE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.send-active {
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 138, 128, 0.4);
}

.send-active:active {
  transform: scale(0.95);
}

.send-icon {
  font-size: 32rpx;
  color: #999999;
  transform: rotate(45deg);
}

.send-active .send-icon {
  color: #FFFFFF;
}
