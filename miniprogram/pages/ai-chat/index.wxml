<!--AI 对话页面 index.wxml-->
<view class="chat-container">
  <!-- 顶部导航区域（包含模式选择） -->
  <view class="chat-header">
    <!-- 顶部栏 -->
    <view class="header-top">
      <!-- 左侧：返回按钮（logo） -->
      <view class="header-back" bindtap="onClose">
        <view class="back-avatar">
          <image class="back-logo" src="/images/icons/close.png" mode="aspectFit"></image>
        </view>
      </view>
      
      <!-- 中间：标题和状态 -->
      <view class="header-center">
        <text class="bot-name">愈见·艺呦</text>
        <text class="bot-status">{{currentModeName}}</text>
      </view>
      
      <!-- 右侧：播放最近引导 -->
      <view class="header-right" bindtap="onPlayGuide">
        <text class="guide-play-text">引导</text>
      </view>
    </view>

    <!-- 模式选择栏 -->
    <view class="mode-selector">
      <view 
        class="mode-item {{currentMode === 'comfort' ? 'mode-active' : ''}}"
        bindtap="onModeChange"
        data-mode="comfort"
      >
        <text class="mode-icon">🌙</text>
        <text class="mode-name">树洞</text>
      </view>
      <view 
        class="mode-item {{currentMode === 'therapist' ? 'mode-active' : ''}}"
        bindtap="onModeChange"
        data-mode="therapist"
      >
        <text class="mode-icon">🩺</text>
        <text class="mode-name">疗愈师</text>
      </view>
      <view 
        class="mode-item {{currentMode === 'companion' ? 'mode-active' : ''}}"
        bindtap="onModeChange"
        data-mode="companion"
      >
        <text class="mode-icon">☕</text>
        <text class="mode-name">日常陪伴</text>
      </view>
    </view>

    <!-- 语音疗愈入口 -->
    <view class="voice-strip">
      <view class="voice-copy">
        <text class="voice-title">语音疗愈</text>
        <text class="voice-status">闭上眼，和艺呦听与说</text>
      </view>
      <view class="voice-actions">
        <view class="voice-pill voice-start-pill" bindtap="onVoiceTap">
          <text>开始</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 消息列表区域 -->
  <scroll-view 
    class="message-area" 
    scroll-y="true" 
    scroll-into-view="{{scrollToMessage}}"
    scroll-with-animation="true"
  >
    <view class="message-list">
      <block wx:for="{{messages}}" wx:key="id">
        <!-- 机器人消息 -->
        <view wx:if="{{item.type === 'bot'}}" class="message-item bot-message" id="msg-{{item.id}}">
          <view class="message-avatar">
            <image class="avatar-logo" src="https://artcure-1369706839.cos.ap-shanghai.myqcloud.com/pic/main_page/ip.png" mode="aspectFit"></image>
          </view>
          <view class="message-bubble bot-bubble">
            <rich-text class="message-text" nodes="{{item.richText || item.text}}"></rich-text>
          </view>
        </view>
        
        <!-- 用户消息 -->
        <view wx:else class="message-item user-message" id="msg-{{item.id}}">
          <view class="message-bubble user-bubble">
            <text class="message-text user-text">{{item.text}}</text>
          </view>
        </view>
      </block>
      
      <!-- 正在输入提示 -->
      <view wx:if="{{isTyping}}" class="message-item bot-message">
        <view class="message-avatar">
          <image class="avatar-logo" src="/images/index/ip.png" mode="aspectFit"></image>
        </view>
        <view class="message-bubble bot-bubble typing-bubble">
          <view class="typing-indicator">
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部占位 -->
    <view class="scroll-bottom" id="scroll-bottom"></view>
  </scroll-view>

  <!-- 快捷问题区域 -->
  <view class="quick-questions-wrapper">
    <scroll-view class="quick-questions" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="quick-list">
        <view 
          class="quick-item" 
          wx:for="{{quickQuestions}}" 
          wx:key="*this"
          bindtap="onQuickQuestion"
          data-question="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-wrapper">
      <view class="voice-input-btn {{isRecording ? 'voice-input-recording' : ''}}" bindtap="onVoiceTap">
        <text>{{isRecording ? '■' : '麦'}}</text>
      </view>
      <input 
        class="message-input" 
        placeholder="在这里倾诉..." 
        placeholder-class="input-placeholder"
        value="{{inputText}}"
        bindinput="onInputChange"
        bindconfirm="onSend"
        confirm-type="send"
        adjust-position="{{true}}"
        cursor-spacing="20"
      />
      <view class="send-btn {{inputText ? 'send-active' : ''}}" bindtap="onSend">
        <text class="send-icon">➤</text>
      </view>
    </view>
  </view>
</view>
