/* activity-detail/index.wxss */
page {
  background: #F5F5F5;
}

.detail-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: calc(20rpx + env(safe-area-inset-top)) 32rpx 20rpx;
  z-index: 10;
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #333;
}

.cover-image {
  width: 100%;
  height: 500rpx;
}

.detail-content {
  background: #FFF;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -32rpx;
  padding: 32rpx;
}

.activity-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.info-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.info-icon {
  margin-right: 12rpx;
}

.desc-section {
  margin-bottom: 32rpx;
}

.consult-section {
  margin-bottom: 120rpx;
}

.consult-btn {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
  text-align: center;
  font-size: 28rpx;
  color: #667eea;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFF;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}

.price-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.book-btn {
  padding: 20rpx 64rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF9A8B 0%, #FECFEF 100%);
  color: #FFF;
  font-size: 28rpx;
  font-weight: 600;
}
