<!--activity-detail/index.wxml-->
<view class="detail-container">
  <view class="detail-header">
    <view class="header-back" bindtap="onBack">‹</view>
  </view>

  <image class="cover-image" src="{{activity.coverImage}}" mode="aspectFill" />

  <view class="detail-content">
    <text class="activity-title">{{activity.title}}</text>

    <view class="info-section">
      <view class="info-item">
        <text class="info-icon">📅</text>
        <text>{{activity.timeText}}</text>
      </view>
      <view class="info-item">
        <text class="info-icon">📍</text>
        <text>{{activity.location}}</text>
      </view>
      <view class="info-item">
        <text class="info-icon">👥</text>
        <text>{{activity.currentParticipants}}/{{activity.maxParticipants}}人</text>
      </view>
      <view class="info-item">
        <text class="info-icon">👨‍⚕️</text>
        <text>疗愈师：{{activity.therapistName}}</text>
      </view>
    </view>

    <view class="desc-section">
      <text class="section-title">活动介绍</text>
      <text class="desc-text">{{activity.description}}</text>
    </view>

    <view class="consult-section">
      <view class="consult-btn" bindtap="onConsult">
        <text>💬 咨询疗愈师</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <text class="price-text">¥{{activity.price}}</text>
    <view class="book-btn" bindtap="onBook">立即预约</view>
  </view>
</view>
