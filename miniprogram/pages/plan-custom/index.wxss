/* plan-custom/index.wxss */
page {
  background: linear-gradient(180deg, #FFF5F7 0%, #F0F8FF 50%, #FFFBF0 100%);
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
}

/* 返回按钮 */
.back-button {
  position: fixed;
  top: 60rpx;
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  backdrop-filter: blur(10rpx);
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 600;
}

/* 主容器 */
.container {
  padding: 60rpx 40rpx 40rpx;
  max-width: 700rpx;
  margin: 0 auto;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  margin-top: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 表单卡片 */
.form-card {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  max-height: calc(100vh - 400rpx);
}

.form-scroll {
  max-height: calc(100vh - 400rpx);
}

/* 表单区块 */
.form-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

/* 输入框 */
.input-field {
  width: 100%;
  height: 88rpx;
  background: #F8F8F8;
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-field:focus {
  border-color: #FFB7B2;
  background-color: #FFFFFF;
}

/* 选项行 */
.options-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.option-item {
  flex: 1;
  min-width: 140rpx;
  height: 76rpx;
  background: #F8F8F8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.option-item.selected {
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  color: #FFFFFF;
  border-color: #FFB7B2;
  box-shadow: 0 4rpx 16rpx rgba(255, 138, 128, 0.3);
  transform: scale(1.02);
}

/* 主题网格 */
.themes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.theme-item {
  height: 76rpx;
  background: #F8F8F8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.theme-item.selected {
  background: linear-gradient(135deg, #A8E6CF 0%, #7FD8BE 100%);
  color: #FFFFFF;
  border-color: #A8E6CF;
  box-shadow: 0 4rpx 16rpx rgba(127, 216, 190, 0.3);
  transform: scale(1.02);
}

/* 文本域 */
.textarea-field {
  width: 100%;
  min-height: 240rpx;
  background: #F8F8F8;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.textarea-field:focus {
  border-color: #FFB7B2;
  background-color: #FFFFFF;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 按钮容器 */
.button-container {
  margin: 50rpx 0 30rpx;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FFB7B2 0%, #FF8A80 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 128, 0.35);
  border: none;
  transition: all 0.3s ease;
}

.generate-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
  transform: scale(0.98);
}

.generate-btn::after {
  border: none;
}

/* 提示 */
.tips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.tips-icon {
  font-size: 32rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
}
